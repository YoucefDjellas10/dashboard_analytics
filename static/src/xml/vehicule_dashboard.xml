<!-- Header -->
<div class="vdd-header">
    <div style="display:flex; align-items:center; gap:10px;">
        <button class="vdd-btn" t-on-click="retour">← Retour</button>
        <div class="vdd-title">
            🚗 <t t-esc="state.matricule"/> (<t t-esc="state.numero"/>) — Historique mensuel
        </div>
    </div>
</div>

<!-- Loading -->
<t t-if="state.loading">
    <div style="text-align:center; padding:60px; font-size:16px; color:#94a3b8;">⏳ Chargement…</div>
</t>
<t t-else="">

    <!-- Cartes résumé -->
    <div class="vdd-cards">
        <div class="vdd-card" style="background:linear-gradient(135deg,#fef3c7,#fde68a); color:#78350f;">
            <div class="vdd-card-titre">Prix d'achat</div>
            <div class="vdd-card-valeur"><t t-esc="prixAchatFormatted"/> DA</div>
            <div class="vdd-card-sub" t-if="state.date_service_str">
                🗓️ En service depuis le <t t-esc="state.date_service_str"/>
            </div>
        </div>
        <div class="vdd-card" style="background:linear-gradient(135deg,#ede9fe,#ddd6fe); color:#3730a3;">
            <div class="vdd-card-titre">Valeur actuelle</div>
            <div class="vdd-card-valeur"><t t-esc="valeurActuelleFormatted"/> DA</div>
        </div>
        <div class="vdd-card" t-attf-style="background:linear-gradient(135deg,{{ isPositive(state.total_balance) ? '#e0e7ff,#c7d2fe' : '#fee2e2,#fecaca' }}); color:{{ isPositive(state.total_balance) ? '#1e1b4b' : '#7f1d1d' }};">
            <div class="vdd-card-titre">Balance totale</div>
            <div class="vdd-card-valeur"><t t-esc="totalBalanceFormatted"/> DA</div>
        </div>
    </div>

    <!-- Tableau mensuel -->
    <div class="vdd-card-table">
        <div class="vdd-scroll">
            <table class="vdd-table">
                <thead>
                    <tr>
                        <th style="min-width:160px;">Mois</th>
                        <th>Revenu (DA)</th>
                        <th>Dépense (DA)</th>
                        <th>Balance (DA)</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-if="state.rows.length === 0">
                        <tr><td colspan="4" style="text-align:center; color:#94a3b8; padding:30px;">Aucun mouvement pour ce véhicule</td></tr>
                    </t>
                    <t t-foreach="state.rows" t-as="row" t-key="row.key">
                        <tr>
                            <td>📅 <t t-esc="row.label"/></td>
                            <td><t t-esc="fmt(row.revenu)"/></td>
                            <td><t t-esc="fmt(row.depense)"/></td>
                            <td t-attf-class="{{ isPositive(row.balance) ? 'vdd-pos' : 'vdd-neg' }}">
                                <t t-esc="fmt(row.balance)"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
                <tfoot>
