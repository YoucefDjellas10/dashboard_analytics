<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dashboard_analytics.TresorerieDashboard">
<div style="padding:16px; background:#f1f5f9;">
<style>
.o_action { overflow-y:auto !important; height:100% !important; }
.o_view_controller { overflow-y:auto !important; height:100% !important; }
.o_action_manager { overflow-y:auto !important; }

.tr-header {
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;
    background:#fff; border-radius:16px; padding:16px 24px; margin-bottom:20px;
    border:1px solid #e2e8f0; box-shadow:0 4px 16px rgba(0,0,0,.07);
}
.tr-title { font-size:20px; font-weight:800; color:#1e293b; }
.tr-select-zone, .tr-select-year {
    border-radius:8px; border:1.5px solid #e2e8f0; font-size:13px;
    color:#1e293b; background:#f8fafc; padding:7px 12px;
}
.tr-select-zone { width:220px; }
.tr-select-year { width:120px; font-weight:700; }
.tr-table-wrapper {
    background:#fff; border-radius:16px; border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07); overflow:hidden;
}
.tr-table { width:100%; border-collapse:collapse; }
.tr-table thead tr { background:linear-gradient(135deg,#065f46,#16a34a); color:#fff; }
.tr-table th { padding:14px 20px; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.6px; text-align:center; }
.tr-table th:first-child { text-align:left; }
.tr-table td { padding:13px 20px; font-size:14px; text-align:center; border-bottom:1px solid #f1f5f9; color:#1e293b; }
.tr-table td:first-child { text-align:left; font-weight:700; color:#475569; }
.tr-table tbody tr:hover td { background:#f0fdf4; }
.tr-table tfoot tr { background:linear-gradient(135deg,#f0fdf4,#dcfce7); font-weight:800; }
.tr-table tfoot td { border-top:2px solid #bbf7d0; font-size:14px; }
.tr-clickable { cursor:pointer; color:#065f46; font-weight:700; text-decoration:underline dotted; }
.tr-clickable:hover { color:#16a34a; }
.tr-badge { display:inline-block; padding:3px 10px; border-radius:20px; font-size:12px; font-weight:800; color:#fff; }
.tr-badge-up   { background:#16a34a; }
.tr-badge-down { background:#dc2626; }
.tr-badge-null { background:#94a3b8; }
.tr-btn-retour {
    display:flex; align-items:center; gap:6px; padding:8px 18px;
    border-radius:9px; border:1.5px solid #e2e8f0; background:#f8fafc;
    color:#475569; font-size:13px; font-weight:600; cursor:pointer;
    transition:background .2s, transform .15s;
}
.tr-btn-retour:hover { background:#e2e8f0; transform:translateY(-2px); }
</style>

<div class="tr-header">
    <div style="display:flex; align-items:center; gap:10px;">
        <button class="tr-btn-retour" t-on-click="retourDashboard">← Retour</button>
        <div class="tr-title">Comparaison mensuelle de la Trésorerie</div>
    </div>
    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase;">Année</span>
            <select class="tr-select-year form-select form-select-sm" t-on-change="updateSelectedYear">
                <t t-foreach="state.years" t-as="year" t-key="year">
                    <option t-att-value="year" t-att-selected="state.annee_n == year" t-esc="year"/>
                </t>
            </select>
        </div>
        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase;">Zone</span>
            <select class="tr-select-zone form-select form-select-sm" t-on-change="updateSelectedZone">
                <option value="">🌍 Toutes les zones</option>
                <t t-foreach="state.zones" t-as="zone" t-key="zone.id">
                    <option t-att-value="zone.id" t-att-selected="state.selected_zone == zone.id" t-esc="zone.name"/>
                </t>
            </select>
        </div>
    </div>
</div>

<t t-if="state.loading">
    <div style="text-align:center; padding:60px; font-size:16px; color:#94a3b8;">⏳ Chargement…</div>
</t>

<t t-else="">
    <div class="tr-table-wrapper">
        <table class="tr-table">
            <thead>
                <tr>
                    <th>Mois</th>
                    <th><t t-esc="state.annee_n1"/> (DA)</th>
                    <th><t t-esc="state.annee_n"/> (DA)</th>
                    <th>Évolution</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="state.rows" t-as="row" t-key="row.mois">
                    <tr>
                        <td><t t-esc="row.label"/></td>
                        <td class="tr-clickable" t-on-click="() => this.ouvrirMois(state.annee_n1, row.mois)">
                            <t t-esc="fmtRow(row.tr_n1)"/>
                        </td>
                        <td class="tr-clickable" t-on-click="() => this.ouvrirMois(state.annee_n, row.mois)">
                            <t t-esc="fmtRow(row.tr_n)"/>
                        </td>
                        <td>
                            <t t-if="row.delta !== null">
                                <span t-attf-class="tr-badge {{ row.delta >= 0 ? 'tr-badge-up' : 'tr-badge-down' }}">
                                    <t t-if="row.delta >= 0">▲ +<t t-esc="row.delta"/> %</t>
                                    <t t-else="">▼ <t t-esc="row.delta"/> %</t>
                                </span>
                            </t>
                            <t t-else=""><span class="tr-badge tr-badge-null">—</span></t>
                        </td>
                    </tr>
                </t>
            </tbody>
            <tfoot>
                <tr>
                    <td>Total</td>
                    <td><t t-esc="totalN1Fmt"/></td>
                    <td><t t-esc="totalNFmt"/></td>
                    <td>
                        <t t-if="totalDelta !== null">
                            <span t-attf-class="tr-badge {{ totalDelta >= 0 ? 'tr-badge-up' : 'tr-badge-down' }}">
                                <t t-if="totalDelta >= 0">▲ +<t t-esc="totalDelta"/> %</t>
                                <t t-else="">▼ <t t-esc="totalDelta"/> %</t>
                            </span>
                        </t>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="tr-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:16px;">
            📊 Comparaison mensuelle — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>
        <canvas id="tr-chart" style="width:100%; max-height:400px;"/>
    </div>

    <div class="tr-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:16px;">
            📈 Évolution mensuelle — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>
        <canvas id="tr-chart-line" style="width:100%; max-height:400px;"/>
    </div>
</t>

</div>
    </t>


    <!-- ═══════════════════════════════════════════════════════════
         PAGE DÉTAIL TRÉSORERIE
         ═══════════════════════════════════════════════════════════ -->
    <t t-name="dashboard_analytics.TresorerieDetailDashboard">
<div style="padding:16px; background:#f1f5f9; min-height:100vh; overflow-y:auto;">
<style>
.o_action { overflow-y: auto !important; height: 100% !important; }
.o_view_controller { overflow-y: auto !important; height: 100% !important; }
.o_action_manager { overflow-y: auto !important; }
.o_content { overflow-y: auto !important; height: 100% !important; }

.trd-header {
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;
    background:#fff; border-radius:16px; padding:16px 24px; margin-bottom:20px;
    border:1px solid #e2e8f0; box-shadow:0 4px 16px rgba(0,0,0,.07);
}
.trd-title    { font-size:18px; font-weight:800; color:#1e293b; }
.trd-subtitle { font-size:13px; color:#64748b; font-weight:500; margin-top:2px; }
.trd-btn {
    display:flex; align-items:center; gap:6px; padding:8px 18px;
    border-radius:9px; border:1.5px solid #e2e8f0; background:#f8fafc;
    color:#475569; font-size:13px; font-weight:600; cursor:pointer;
    transition:background .2s, transform .15s;
}
.trd-btn:hover { background:#e2e8f0; transform:translateY(-2px); }

.trd-card {
    background:#fff; border-radius:16px; border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07); overflow:hidden; margin-bottom:20px;
}
.trd-card-title {
    font-size:15px; font-weight:800; color:#1e293b;
    padding:18px 24px 12px; border-bottom:1px solid #f1f5f9;
}
.trd-scroll { overflow-x:auto; -webkit-overflow-scrolling:touch; }

/* ══════════════════════════════════════════════════
   TABLEAU CROISÉ — COULEUR VERTE UNIFORME (tous les 3 tableaux)
   ══════════════════════════════════════════════════ */
.trd-cross-table { width:100%; border-collapse:collapse; font-size:13px; }
.trd-cross-table thead tr { background:linear-gradient(135deg,#065f46,#16a34a); color:#fff; }
.trd-cross-table thead th {
    padding:12px 16px; font-weight:700; text-transform:uppercase;
    letter-spacing:.5px; text-align:center; white-space:nowrap;
}
.trd-cross-table thead th:first-child { text-align:left; }

/* ── Lignes ZONE (vert/teal) ── */
.trd-zone-row {
    background:linear-gradient(90deg,#f0fdf4 0%,#ecfdf5 100%);
    cursor:pointer; user-select:none; border-bottom:1px solid #bbf7d0;
}
.trd-zone-row:hover { background:linear-gradient(90deg,#dcfce7 0%,#d1fae5 100%); }
.trd-zone-row td {
    padding:11px 16px; font-weight:800; font-size:13px;
    color:#065f46; border-bottom:1px solid #bbf7d0;
}
.trd-zone-row td:first-child {
    text-align:left; white-space:nowrap; position:sticky; left:0; z-index:2;
    background:linear-gradient(90deg,#f0fdf4 0%,#ecfdf5 100%);
    border-right:1px solid #bbf7d0;
}
.trd-zone-toggle { display:inline-flex; align-items:center; gap:8px; }
.trd-zone-arrow  { display:inline-block; font-size:11px; transition:transform .2s ease; color:#16a34a; }
.trd-zone-arrow.open { transform:rotate(90deg); }
.trd-zone-cell-montant { font-weight:800; color:#16a34a; font-size:13px; }
.trd-zone-cell-count   { font-size:11px; color:#4ade80; font-weight:500; }
.trd-zone-total-col    { background:#dcfce7 !important; border-left:2px solid #86efac !important; }

/* ── Lignes MODELE (vert légèrement plus foncé pour différencier) ── */
.trd-modele-row {
    background:linear-gradient(90deg,#ecfdf5 0%,#f0fdf4 100%);
    cursor:pointer; user-select:none; border-bottom:1px solid #86efac;
}
.trd-modele-row:hover { background:linear-gradient(90deg,#d1fae5 0%,#dcfce7 100%); }
.trd-modele-row td {
    padding:11px 16px; font-weight:800; font-size:13px;
    color:#064e3b; border-bottom:1px solid #86efac;
}
.trd-modele-row td:first-child {
    text-align:left; white-space:nowrap; position:sticky; left:0; z-index:2;
    background:linear-gradient(90deg,#ecfdf5 0%,#f0fdf4 100%);
    border-right:1px solid #86efac;
}
.trd-modele-toggle { display:inline-flex; align-items:center; gap:8px; }
.trd-modele-arrow  { display:inline-block; font-size:11px; transition:transform .2s ease; color:#059669; }
.trd-modele-arrow.open { transform:rotate(90deg); }
.trd-modele-cell-montant { font-weight:800; color:#059669; font-size:13px; }
.trd-modele-cell-count   { font-size:11px; color:#6ee7b7; font-weight:500; }
.trd-modele-total-col    { background:#a7f3d0 !important; border-left:2px solid #6ee7b7 !important; }

/* ── Lignes LIEU / VEHICULE ── */
.trd-lieu-row td, .trd-vehicule-row td {
    padding:9px 16px; text-align:center; border-bottom:1px solid #f1f5f9;
    color:#1e293b; font-size:13px;
}
.trd-lieu-row td:first-child, .trd-vehicule-row td:first-child {
    text-align:left; font-weight:600; color:#475569; background:#f0fdf4;
    white-space:nowrap; position:sticky; left:0; z-index:2;
    border-right:1px solid #bbf7d0; padding-left:32px;
}
.trd-lieu-row:hover td, .trd-vehicule-row:hover td { background:#f0fdf4; }
.trd-lieu-row:hover td:first-child, .trd-vehicule-row:hover td:first-child { background:#dcfce7; }

.trd-cell-montant { font-weight:800; color:#065f46; font-size:13px; }
.trd-cell-count   { font-size:11px; color:#94a3b8; font-weight:500; }
.trd-cell-empty   { color:#e2e8f0; font-size:18px; }

.trd-total-row td {
    background:linear-gradient(135deg,#ecfdf5,#d1fae5) !important;
    font-weight:800 !important; border-top:2px solid #6ee7b7 !important;
    font-size:13px; padding:11px 16px; text-align:center;
}
.trd-total-row td:first-child { text-align:left; }
.trd-total-col { background:#bbf7d0 !important; border-left:2px solid #6ee7b7 !important; }

.trd-duo-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px; }
.trd-chart-title { font-size:14px; font-weight:700; color:#475569; padding:16px 20px 12px; border-bottom:1px solid #f1f5f9; }
.trd-heatmap-legend { display:flex; align-items:center; gap:8px; font-size:11px; color:#64748b; font-weight:600; padding:12px 20px 16px; }
.trd-heatmap-legend-bar { width:120px; height:12px; border-radius:6px; background:linear-gradient(to right,#f1f5f9,#bbf7d0,#16a34a,#064e3b); }

@media (max-width:1024px) {
    .trd-cross-table { font-size:12px; }
    .trd-cross-table thead th, .trd-zone-row td, .trd-modele-row td,
    .trd-lieu-row td, .trd-vehicule-row td, .trd-total-row td { padding:8px 10px; }
}
@media (max-width:768px) {
    .trd-header { padding:12px; gap:8px; border-radius:12px; }
    .trd-title  { font-size:15px; }
    .trd-card   { border-radius:12px; margin-bottom:12px; }
    .trd-duo-grid { grid-template-columns:1fr !important; gap:12px; }
    .trd-cross-table { font-size:11px; }
    .trd-cross-table thead th, .trd-zone-row td, .trd-modele-row td,
    .trd-lieu-row td, .trd-vehicule-row td, .trd-total-row td { padding:6px 8px; }
    .trd-lieu-row td:first-child, .trd-vehicule-row td:first-child { padding-left:20px; }
    canvas { max-height:220px !important; }
    .trd-heatmap-legend-bar { width:80px; }
}
@media (max-width:480px) {
    .trd-cross-table { font-size:10px; }
    .trd-cross-table thead th, .trd-zone-row td, .trd-modele-row td,
    .trd-lieu-row td, .trd-vehicule-row td, .trd-total-row td { padding:5px 6px; }
    canvas { max-height:180px !important; }
}
</style>

    <!-- Header -->
    <div class="trd-header">
        <div>
            <button class="trd-btn" t-on-click="retour">← Retour</button>
        </div>
        <div style="flex:1; padding:0 16px;">
            <div class="trd-title">💰 Détail de la Trésorerie</div>
            <div class="trd-subtitle"><t t-esc="state.label"/></div>
        </div>
        <div style="
            background:linear-gradient(135deg,#065f46 0%,#16a34a 100%);
            border-radius:16px; padding:18px 28px 18px 22px; min-width:210px;
            box-shadow:0 8px 32px rgba(6,95,70,0.35), inset 0 1px 0 rgba(255,255,255,0.15);
        ">
            <div style="font-size:11px; font-weight:700; color:rgba(255,255,255,0.65); text-transform:uppercase; letter-spacing:1.2px; margin-bottom:4px;">Total encaissé</div>
            <div style="font-size:24px; font-weight:900; color:#fff; line-height:1; letter-spacing:-1px;">
                <t t-esc="fmtM(state.grand_total.montant)"/> DA
            </div>
            <div style="font-size:12px; color:rgba(255,255,255,0.6); margin-top:4px;">
                <t t-esc="state.grand_total.count"/> paiements
            </div>
        </div>
    </div>

    <t t-if="state.loading">
        <div style="text-align:center; padding:80px; font-size:16px; color:#94a3b8;">⏳ Chargement des données…</div>
    </t>

    <t t-else="">

        <!-- ══ Tableau 1 : Zones / Lieux × Catégories ══ -->
        <div class="trd-card">
            <div class="trd-card-title">
                🔀 Tableau croisé — Zones / Lieux × Catégories de client
                <span style="font-size:12px; font-weight:500; color:#94a3b8; margin-left:8px;">(cliquez sur une zone pour voir ses lieux)</span>
            </div>
            <div class="trd-scroll">
                <table class="trd-cross-table">
                    <thead>
                        <tr>
                            <th style="min-width:200px;">Zone / Lieu de départ</th>
                            <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                <th><t t-esc="cat.name"/></th>
                            </t>
                            <th style="background:rgba(255,255,255,0.15);">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- MODIFICATION 2 : tri décroissant via sortedZones -->
                        <t t-foreach="sortedZones" t-as="zone" t-key="zone.id">
                            <tr class="trd-zone-row" t-on-click="() => this.toggleZone(zone.id)">
                                <td>
                                    <span class="trd-zone-toggle">
                                        <span t-attf-class="trd-zone-arrow {{ isZoneExpanded(zone.id) ? 'open' : '' }}">▶</span>
                                        🗺️ <t t-esc="zone.name"/>
                                    </span>
                                </td>
                                <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                    <td>
                                        <t t-set="cz" t-value="getCellZone(zone.id, cat.id)"/>
                                        <t t-if="cz.count > 0">
                                            <div class="trd-zone-cell-montant"><t t-esc="fmtM(cz.montant)"/> DA</div>
                                            <div class="trd-zone-cell-count">(<t t-esc="cz.count"/> pay)</div>
                                        </t>
                                        <t t-else=""><span class="trd-cell-empty">·</span></t>
                                    </td>
                                </t>
                                <td class="trd-zone-total-col">
                                    <t t-set="tz" t-value="getTotalZone(zone.id)"/>
                                    <div class="trd-zone-cell-montant"><t t-esc="fmtM(tz.montant)"/> DA</div>
                                    <div class="trd-zone-cell-count">(<t t-esc="tz.count"/> pay)</div>
                                </td>
                            </tr>
                            <t t-if="isZoneExpanded(zone.id)">
                                <!-- getLieuxByZone retourne déjà trié décroissant -->
                                <t t-foreach="getLieuxByZone(zone.id)" t-as="lieu" t-key="lieu.id">
                                    <tr class="trd-lieu-row">
                                        <td>📍 <t t-esc="lieu.name"/></td>
                                        <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                            <td>
                                                <t t-set="cell" t-value="getCellLieu(lieu.id, cat.id)"/>
                                                <t t-if="cell.count > 0">
                                                    <div class="trd-cell-montant"><t t-esc="fmtM(cell.montant)"/> DA</div>
                                                    <div class="trd-cell-count">(<t t-esc="cell.count"/> pay)</div>
                                                </t>
                                                <t t-else=""><span class="trd-cell-empty">·</span></t>
                                            </td>
                                        </t>
                                        <td class="trd-total-col">
                                            <t t-set="tl" t-value="getTotalLieu(lieu.id)"/>
                                            <div class="trd-cell-montant"><t t-esc="fmtM(tl.montant)"/> DA</div>
                                            <div class="trd-cell-count">(<t t-esc="tl.count"/> pay)</div>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="trd-total-row">
                            <td>Total général</td>
                            <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                <td>
                                    <t t-set="tc" t-value="getTotalCat(cat.id)"/>
                                    <div class="trd-cell-montant"><t t-esc="fmtM(tc.montant)"/> DA</div>
                                    <div class="trd-cell-count">(<t t-esc="tc.count"/> pay)</div>
                                </td>
                            </t>
                            <td class="trd-total-col">
                                <div class="trd-cell-montant" style="color:#065f46;">
                                    <t t-esc="fmtM(state.grand_total.montant)"/> DA
                                </div>
                                <div class="trd-cell-count">(<t t-esc="state.grand_total.count"/> pay)</div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- ══ Tableau 2 : Modèles / Véhicules × Catégories ══ -->
        <div class="trd-card">
            <div class="trd-card-title">
                 Tableau croisé — Modèles / Véhicules × Catégories de client
                <span style="font-size:12px; font-weight:500; color:#94a3b8; margin-left:8px;">(cliquez sur un modèle pour voir ses véhicules)</span>
            </div>
            <div class="trd-scroll">
                <table class="trd-cross-table">
                    <thead>
                        <tr>
                            <th style="min-width:200px;">Modèle / Véhicule</th>
                            <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                <th><t t-esc="cat.name"/></th>
                            </t>
                            <th style="background:rgba(255,255,255,0.15);">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- MODIFICATION 2 : tri décroissant via sortedModeles -->
                        <t t-foreach="sortedModeles" t-as="modele" t-key="modele.id">

                            <!-- Ligne MODELE -->
                            <tr class="trd-modele-row" t-on-click="() => this.toggleModele(modele.id)">
                                <td>
                                    <span class="trd-modele-toggle">
                                        <span t-attf-class="trd-modele-arrow {{ isModeleExpanded(modele.id) ? 'open' : '' }}">▶</span>
                                        🚘 <t t-esc="modele.name"/>
                                    </span>
                                </td>
                                <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                    <td>
                                        <t t-set="cm" t-value="getCellModele(modele.id, cat.id)"/>
                                        <t t-if="cm.count > 0">
                                            <div class="trd-modele-cell-montant"><t t-esc="fmtM(cm.montant)"/> DA</div>
                                            <div class="trd-modele-cell-count">(<t t-esc="cm.count"/> pay)</div>
                                        </t>
                                        <t t-else=""><span class="trd-cell-empty">·</span></t>
                                    </td>
                                </t>
                                <td class="trd-modele-total-col">
                                    <t t-set="tm" t-value="getTotalModele(modele.id)"/>
                                    <div class="trd-modele-cell-montant"><t t-esc="fmtM(tm.montant)"/> DA</div>
                                    <div class="trd-modele-cell-count">(<t t-esc="tm.count"/> pay)</div>
                                </td>
                            </tr>

                            <!-- Lignes VEHICULES — getVehiculesByModele retourne déjà trié décroissant, actifs uniquement -->
                            <t t-if="isModeleExpanded(modele.id)">
                                <t t-foreach="getVehiculesByModele(modele.id)" t-as="veh" t-key="veh.id">
                                    <tr class="trd-vehicule-row">
                                        <td> <t t-esc="veh.numero"/></td>
                                        <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                            <td>
                                                <t t-set="cv" t-value="getCellVehicule(veh.id, cat.id)"/>
                                                <t t-if="cv.count > 0">
                                                    <div class="trd-cell-montant"><t t-esc="fmtM(cv.montant)"/> DA</div>
                                                    <div class="trd-cell-count">(<t t-esc="cv.count"/> pay)</div>
                                                </t>
                                                <t t-else=""><span class="trd-cell-empty">·</span></t>
                                            </td>
                                        </t>
                                        <td class="trd-total-col">
                                            <t t-set="tv" t-value="getTotalVehicule(veh.id)"/>
                                            <div class="trd-cell-montant"><t t-esc="fmtM(tv.montant)"/> DA</div>
                                            <div class="trd-cell-count">(<t t-esc="tv.count"/> pay)</div>
                                        </td>
                                    </tr>
                                </t>
                            </t>

                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="trd-total-row">
                            <td>Total général</td>
                            <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                <td>
                                    <t t-set="tc" t-value="getTotalCat(cat.id)"/>
                                    <div class="trd-cell-montant"><t t-esc="fmtM(tc.montant)"/> DA</div>
                                    <div class="trd-cell-count">(<t t-esc="tc.count"/> pay)</div>
                                </td>
                            </t>
                            <td class="trd-total-col">
                                <div class="trd-cell-montant" style="color:#064e3b;">
                                    <t t-esc="fmtM(state.grand_total.montant)"/> DA
                                </div>
                                <div class="trd-cell-count">(<t t-esc="state.grand_total.count"/> pay)</div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- ══ Tableau 3 : Modèles × Zones ══ -->
        <div class="trd-card">
            <div class="trd-card-title">
                🗺️ Tableau croisé — Modèles × Zones
                <span style="font-size:12px; font-weight:500; color:#94a3b8; margin-left:8px;">Trésorerie par modèle de véhicule et par zone</span>
            </div>
            <div class="trd-scroll">
                <table class="trd-cross-table">
                    <thead>
                        <tr>
                            <th style="min-width:180px;">Modèle</th>
                            <t t-foreach="state.zones" t-as="zone" t-key="zone.id">
                                <th><t t-esc="zone.name"/></th>
                            </t>
                            <th style="background:rgba(255,255,255,0.15);">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- MODIFICATION 2 : tri décroissant via sortedModelesZone -->
                        <t t-foreach="sortedModelesZone" t-as="modele" t-key="modele.id">
                            <tr class="trd-modele-row" style="cursor:default;">
                                <td style="cursor:default;">
                                    <span style="display:inline-flex; align-items:center; gap:8px;">
                                        🚘 <t t-esc="modele.name"/>
                                    </span>
                                </td>
                                <t t-foreach="state.zones" t-as="zone" t-key="zone.id">
                                    <td>
                                        <t t-set="cmz" t-value="getCellModeleZone(modele.id, zone.id)"/>
                                        <t t-if="cmz.count > 0">
                                            <div class="trd-modele-cell-montant"><t t-esc="fmtM(cmz.montant)"/> DA</div>
                                            <div class="trd-modele-cell-count">(<t t-esc="cmz.count"/> pay)</div>
                                        </t>
                                        <t t-else=""><span class="trd-cell-empty">·</span></t>
                                    </td>
                                </t>
                                <td class="trd-modele-total-col">
                                    <t t-set="tmz" t-value="getTotalModeleZone(modele.id)"/>
                                    <div class="trd-modele-cell-montant"><t t-esc="fmtM(tmz.montant)"/> DA</div>
                                    <div class="trd-modele-cell-count">(<t t-esc="tmz.count"/> pay)</div>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="trd-total-row">
                            <td>Total général</td>
                            <t t-foreach="state.zones" t-as="zone" t-key="zone.id">
                                <td>
                                    <t t-set="tz" t-value="getTotalZoneAllModeles(zone.id)"/>
                                    <div class="trd-cell-montant"><t t-esc="fmtM(tz.montant)"/> DA</div>
                                    <div class="trd-cell-count">(<t t-esc="tz.count"/> pay)</div>
                                </td>
                            </t>
                            <td class="trd-total-col">
                                <div class="trd-cell-montant" style="color:#064e3b;">
                                    <t t-esc="fmtM(state.grand_total.montant)"/> DA
                                </div>
                                <div class="trd-cell-count">(<t t-esc="state.grand_total.count"/> pay)</div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Duo : Jour semaine + Heatmap -->
        <div class="trd-duo-grid">
            <div class="trd-card" style="margin-bottom:0;">
                <div class="trd-chart-title">
                    📅 Trésorerie par jour de la semaine
                    <div style="font-size:11px; color:#94a3b8; font-weight:500; margin-top:2px;">Montant DA encaissé par jour</div>
                </div>
                <div style="padding:16px;">
                    <canvas id="trd-chart-jour-semaine" style="width:100%; max-height:320px;"/>
                </div>
            </div>
            <div class="trd-card" style="margin-bottom:0;">
                <div class="trd-chart-title">🗓️ Heatmap — semaine × jour (DA)</div>
                <div class="trd-heatmap-legend">
                    <span>Faible</span>
                    <div class="trd-heatmap-legend-bar"/>
                    <span>Élevé</span>
                </div>
                <div id="trd-heatmap-container" style="padding:0 16px 16px; overflow-x:auto;"/>
            </div>
        </div>

    </t>

</div>
    </t>

</templates>