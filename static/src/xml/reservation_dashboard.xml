<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dashboard_analytics.ReservationDashboard">
<div style="padding:16px; background:#f1f5f9;">
<style>
  .o_action {
    overflow-y: auto !important;
    height: 100% !important;
}

.o_view_controller {
    overflow-y: auto !important;
    height: 100% !important;
}

.o_action_manager {
    overflow-y: auto !important;
}
.rd-header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:12px;
    background:#fff;
    border-radius:16px;
    padding:16px 24px;
    margin-bottom:20px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
}
.rd-title {
    font-size:20px;
    font-weight:800;
    color:#1e293b;
}
.rd-select-zone,
.rd-select-year {
    border-radius:8px;
    border:1.5px solid #e2e8f0;
    font-size:13px;
    color:#1e293b;
    background:#f8fafc;
    padding:7px 12px;
}
.rd-select-zone { width:220px; }
.rd-select-year { width:120px; font-weight:700; }
.rd-table-wrapper {
    background:#fff;
    border-radius:16px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
    overflow:hidden;
}
.rd-table {
    width:100%;
    border-collapse:collapse;
}
.rd-table thead tr {
    background:linear-gradient(135deg,#1565c0,#6a1b9a);
    color:#fff;
}
.rd-table th {
    padding:14px 20px;
    font-size:13px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.6px;
    text-align:center;
}
.rd-table th:first-child { text-align:left; }
.rd-table td {
    padding:13px 20px;
    font-size:14px;
    text-align:center;
    border-bottom:1px solid #f1f5f9;
    color:#1e293b;
}
.rd-table td:first-child {
    text-align:left;
    font-weight:700;
    color:#475569;
}
.rd-table tbody tr:hover td {
    background:#f8fafc;
}
.rd-table tfoot tr {
    background:linear-gradient(135deg,#f8fafc,#f1f5f9);
    font-weight:800;
}
.rd-table tfoot td {
    border-top:2px solid #e2e8f0;
    font-size:14px;
}
.rd-clickable {
    cursor:pointer;
    color:#1565c0;
    font-weight:700;
    text-decoration:underline dotted;
}
.rd-clickable:hover { color:#6a1b9a; }

/* Cellule réservation : nombre + jours */
.rd-cell-main {
    font-size:14px;
    font-weight:800;
    color:#1565c0;
}
.rd-cell-jours {
    font-size:12px;
    font-weight:600;
    color:#64748b;
    margin-left:4px;
}

/* Évolution : deux badges côte à côte sur la même ligne */
.rd-evo-wrap {
    display:inline-flex;
    flex-direction:row;
    align-items:center;
    justify-content:center;
    gap:6px;
    flex-wrap:wrap;
}
.rd-evo-item {
    display:inline-flex;
    align-items:center;
    gap:3px;
}
.rd-evo-label {
    font-size:10px;
    font-weight:600;
    color:#94a3b8;
    text-transform:uppercase;
    letter-spacing:.4px;
}
.rd-badge {
    display:inline-block;
    padding:3px 10px;
    border-radius:20px;
    font-size:12px;
    font-weight:800;
    color:#fff;
}
.rd-badge-up   { background:#16a34a; }
.rd-badge-down { background:#dc2626; }
.rd-badge-null { background:#94a3b8; }

.rd-btn-retour {
    display:flex;
    align-items:center;
    gap:6px;
    padding:8px 18px;
    border-radius:9px;
    border:1.5px solid #e2e8f0;
    background:#f8fafc;
    color:#475569;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    transition:background .2s, transform .15s;
}
.rd-btn-retour:hover {
    background:#e2e8f0;
    transform:translateY(-2px);
}
.rd-pie-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 20px;
}
@media (max-width: 900px) {
    .rd-pie-grid { grid-template-columns: 1fr; }
}
.rd-pie-title {
    font-size:15px;
    font-weight:800;
    color:#1e293b;
    margin-bottom:16px;
    text-align:center;
}

/* Popup */
.rd-popup-overlay {
    position:fixed;
    inset:0;
    background:rgba(0,0,0,0.45);
    z-index:9999;
    display:flex;
    align-items:center;
    justify-content:center;
}
.rd-popup-box {
    background:#fff;
    border-radius:16px;
    border:1px solid #e2e8f0;
    width:440px;
    max-width:95vw;
    overflow:hidden;
    box-shadow:0 20px 60px rgba(0,0,0,.25);
}
.rd-popup-header {
    background:linear-gradient(135deg,#1565c0,#6a1b9a);
    padding:14px 20px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}
.rd-popup-header-title {
    color:#fff;
    font-size:15px;
    font-weight:700;
}
.rd-popup-header-sub {
    color:rgba(255,255,255,0.75);
    font-size:12px;
    margin-top:2px;
}
.rd-popup-close {
    color:#fff;
    font-size:22px;
    cursor:pointer;
    line-height:1;
    padding:0 4px;
    border:none;
    background:transparent;
}
.rd-popup-close:hover { opacity:0.75; }
.rd-popup-body {
    padding:18px 20px;
}
.rd-popup-grid {
    display:grid;
    grid-template-columns:1fr auto auto;
    gap:6px 16px;
    align-items:center;
    font-size:13px;
}
.rd-popup-col-header {
    color:#64748b;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.5px;
    padding-bottom:8px;
    border-bottom:1px solid #e2e8f0;
}
.rd-popup-col-header-right {
    text-align:right;
    color:#64748b;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.5px;
    padding-bottom:8px;
    border-bottom:1px solid #e2e8f0;
}
.rd-popup-zone-name {
    color:#1565c0;
    font-weight:600;
    cursor:pointer;
    text-decoration:underline dotted;
}
.rd-popup-zone-name:hover { color:#6a1b9a; }
.rd-popup-badge {
    display:inline-block;
    background:#E6F1FB;
    color:#0C447C;
    border-radius:20px;
    padding:2px 10px;
    font-weight:700;
    font-size:12px;
}
.rd-popup-badge-total {
    display:inline-block;
    background:#1565c0;
    color:#fff;
    border-radius:20px;
    padding:2px 10px;
    font-weight:700;
    font-size:12px;
}
.rd-popup-jours {
    text-align:right;
    color:#64748b;
    font-size:12px;
}
.rd-popup-separator {
    border-top:1px solid #e2e8f0;
    padding-top:8px;
}
.rd-popup-total-label {
    border-top:1px solid #e2e8f0;
    padding-top:8px;
    font-weight:700;
    color:#1e293b;
}
.rd-popup-total-jours {
    border-top:1px solid #e2e8f0;
    padding-top:8px;
    text-align:right;
    color:#64748b;
    font-size:12px;
}
.rd-popup-footer {
    margin-top:18px;
    display:flex;
    gap:8px;
    justify-content:flex-end;
}
.rd-popup-btn-close {
    font-size:13px;
    padding:8px 18px;
    border-radius:8px;
    border:1px solid #e2e8f0;
    background:#f8fafc;
    color:#475569;
    cursor:pointer;
    font-weight:600;
}
.rd-popup-btn-close:hover { background:#e2e8f0; }
.rd-popup-btn-all {
    font-size:13px;
    padding:8px 18px;
    border-radius:8px;
    border:none;
    background:linear-gradient(135deg,#1565c0,#6a1b9a);
    color:#fff;
    cursor:pointer;
    font-weight:600;
}
.rd-popup-btn-all:hover { opacity:0.9; }
</style>

<!-- Header -->
<div class="rd-header">
    <div style="display:flex; align-items:center; gap:10px;">
        <button class="rd-btn-retour" t-on-click="retourDashboard">
            ← Retour
        </button>
        <div class="rd-title">
          Comparaison mensuelle des réservations
        </div>
    </div>

    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase;">Année</span>
            <select class="rd-select-year form-select form-select-sm"
                    t-on-change="updateSelectedYear">
                <t t-foreach="state.years" t-as="year" t-key="year">
                    <option t-att-value="year"
                            t-att-selected="state.annee_n == year"
                            t-esc="year"/>
                </t>
            </select>
        </div>
        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase;">Zone</span>
            <select class="rd-select-zone form-select form-select-sm"
                    t-on-change="updateSelectedZone">
                <option value="">🌍 Toutes les zones</option>
                <t t-foreach="state.zones" t-as="zone" t-key="zone.id">
                    <option t-att-value="zone.id"
                            t-att-selected="state.selected_zone == zone.id"
                            t-esc="zone.name"/>
                </t>
            </select>
        </div>
    </div>
</div>

<!-- Loading -->
<t t-if="state.loading">
    <div style="text-align:center; padding:60px; font-size:16px; color:#94a3b8;">
        ⏳ Chargement…
    </div>
</t>

<!-- Tableau -->
<t t-else="">
    <div class="rd-table-wrapper">
        <table class="rd-table">
            <thead>
                <tr>
                    <th>Mois</th>
                    <th><t t-esc="state.annee_n1"/></th>
                    <th><t t-esc="state.annee_n"/></th>
                    <th>Évolution</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="state.rows" t-as="row" t-key="row.mois">
                    <tr>
                        <!-- Mois -->
                        <td><t t-esc="row.label"/></td>

                        <!-- Colonne N-1 -->
                        <td class="rd-clickable"
                            t-on-click="() => ouvrirMoisPopup(state.annee_n1, row.mois)">
                            <span class="rd-cell-main"><t t-esc="row.count_n1"/></span><span class="rd-cell-jours">(<t t-esc="row.jours_n1"/> jours)</span>
                        </td>

                        <!-- Colonne N -->
                        <td class="rd-clickable"
                            t-on-click="() => ouvrirMoisPopup(state.annee_n, row.mois)">
                            <span class="rd-cell-main"><t t-esc="row.count_n"/></span><span class="rd-cell-jours">(<t t-esc="row.jours_n"/> jours)</span>
                        </td>

                        <!-- Évolution -->
                        <td>
                            <div class="rd-evo-wrap">
                                <span class="rd-evo-item">
                                    <span class="rd-evo-label">Résv.</span>
                                    <t t-if="row.delta !== null">
                                        <span t-attf-class="rd-badge {{ row.delta >= 0 ? 'rd-badge-up' : 'rd-badge-down' }}">
                                            <t t-if="row.delta >= 0">▲ +<t t-esc="row.delta"/> %</t>
                                            <t t-else="">▼ <t t-esc="row.delta"/> %</t>
                                        </span>
                                    </t>
                                    <t t-else=""><span class="rd-badge rd-badge-null">—</span></t>
                                </span>
                                <span style="color:#e2e8f0;">|</span>
                                <span class="rd-evo-item">
                                    <span class="rd-evo-label">Jours</span>
                                    <t t-if="row.delta_jours !== null">
                                        <span t-attf-class="rd-badge {{ row.delta_jours >= 0 ? 'rd-badge-up' : 'rd-badge-down' }}">
                                            <t t-if="row.delta_jours >= 0">▲ +<t t-esc="row.delta_jours"/> %</t>
                                            <t t-else="">▼ <t t-esc="row.delta_jours"/> %</t>
                                        </span>
                                    </t>
                                    <t t-else=""><span class="rd-badge rd-badge-null">—</span></t>
                                </span>
                            </div>
                        </td>
                    </tr>
                </t>
            </tbody>
            <tfoot>
                <tr>
                    <td>Total</td>
                    <!-- Total N-1 -->
                    <td>
                        <span class="rd-cell-main"><t t-esc="totalN1"/></span><span class="rd-cell-jours">(<t t-esc="totalJoursN1"/> jours)</span>
                    </td>
                    <!-- Total N -->
                    <td>
                        <span class="rd-cell-main"><t t-esc="totalN"/></span><span class="rd-cell-jours">(<t t-esc="totalJoursN"/> jours)</span>
                    </td>
                    <!-- Évolution totale -->
                    <td>
                        <div class="rd-evo-wrap">
                            <div>
                                <span class="rd-evo-label">Résv.</span>
                                <t t-if="totalDelta !== null">
                                    <span t-attf-class="rd-badge {{ totalDelta >= 0 ? 'rd-badge-up' : 'rd-badge-down' }}">
                                        <t t-if="totalDelta >= 0">▲ +<t t-esc="totalDelta"/> %</t>
                                        <t t-else="">▼ <t t-esc="totalDelta"/> %</t>
                                    </span>
                                </t>
                            </div>
                            <div>
                                <span class="rd-evo-label">Jours</span>
                                <t t-if="totalDeltaJours !== null">
                                    <span t-attf-class="rd-badge {{ totalDeltaJours >= 0 ? 'rd-badge-up' : 'rd-badge-down' }}">
                                        <t t-if="totalDeltaJours >= 0">▲ +<t t-esc="totalDeltaJours"/> %</t>
                                        <t t-else="">▼ <t t-esc="totalDeltaJours"/> %</t>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Graphique barres -->
    <div class="rd-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:16px;">
            📊 Comparaison mensuelle — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>
        <canvas id="rd-chart" style="width:100%; max-height:400px;"/>
    </div>

    <!-- Graphique courbe -->
    <div class="rd-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:16px;">
            📈 Évolution mensuelle — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>
        <canvas id="rd-chart-line" style="width:100%; max-height:400px;"/>
    </div>

    <!-- Graphiques Pie côte à côte -->
    <div class="rd-pie-grid">
        <div class="rd-table-wrapper" style="padding:24px;">
            <div class="rd-pie-title">
                🥧 Réservations par zone — <t t-esc="state.annee_n1"/>
            </div>
            <canvas id="rd-chart-pie-n1" style="width:100%; max-height:500px;"/>
        </div>
        <div class="rd-table-wrapper" style="padding:24px;">
            <div class="rd-pie-title">
                🥧 Réservations par zone — <t t-esc="state.annee_n"/>
            </div>
            <canvas id="rd-chart-pie" style="width:100%; max-height:500px;"/>
        </div>
    </div>

</t>

<!-- ═══════════════════════════════════════════
     POPUP RÉPARTITION PAR ZONE
     ═══════════════════════════════════════════ -->
<t t-if="state.popup">
    <div class="rd-popup-overlay" t-on-click="fermerPopup">

        <div class="rd-popup-box" t-on-click.stop="">

            <!-- Header popup -->
            <div class="rd-popup-header">
                <div>
                    <div class="rd-popup-header-title">
                        <t t-esc="state.popup.label"/>
                    </div>
                    <div class="rd-popup-header-sub">Répartition par zone</div>
                </div>
                <button class="rd-popup-close" t-on-click="fermerPopup">✕</button>
            </div>

            <!-- Body popup -->
            <div class="rd-popup-body">

                <!-- Chargement -->
                <t t-if="state.popup_loading">
                    <div style="text-align:center; padding:30px; font-size:14px; color:#94a3b8;">
                        ⏳ Chargement…
                    </div>
                </t>

                <t t-else="">
                    <div class="rd-popup-grid">

                        <!-- En-têtes colonnes -->
                        <div class="rd-popup-col-header">Zone</div>
                        <div class="rd-popup-col-header-right">Résv.</div>
                        <div class="rd-popup-col-header-right">Jours</div>

                        <!-- Lignes par zone -->
                        <t t-foreach="state.popup.zones" t-as="z" t-key="z.id">
                            <div class="rd-popup-zone-name"
                                 t-on-click="() => ouvrirZone(z.id, z.name)">
                                <t t-esc="z.name"/>
                            </div>
                            <div style="text-align:right;">
                                <span class="rd-popup-badge"><t t-esc="z.count"/></span>
                            </div>
                            <div class="rd-popup-jours">
                                <t t-esc="z.jours"/> jrs
                            </div>
                        </t>

                        <!-- Ligne total -->
                        <div class="rd-popup-total-label">Total</div>
                        <div class="rd-popup-separator" style="text-align:right;">
                            <span class="rd-popup-badge-total"><t t-esc="state.popup.totalCount"/></span>
                        </div>
                        <div class="rd-popup-total-jours">
                            <t t-esc="state.popup.totalJours"/> jrs
                        </div>

                    </div>

                    <!-- Boutons footer -->
                    <div class="rd-popup-footer">
                        <button class="rd-popup-btn-close" t-on-click="fermerPopup">
                            Fermer
                        </button>
                        <button class="rd-popup-btn-all" t-on-click="ouvrirMoisDepuisPopup">
                            Voir toutes les résv. →
                        </button>
                    </div>
                </t>

            </div>
        </div>
    </div>
</t>

</div>
    </t>
</templates>