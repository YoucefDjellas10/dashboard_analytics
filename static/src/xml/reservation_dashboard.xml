<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ═══════════════════════════════════════════════════════════
         TEMPLATE PRINCIPAL — ReservationDashboard (inchangé)
         ═══════════════════════════════════════════════════════════ -->
    <t t-name="dashboard_analytics.ReservationDashboard">
<div style="padding:16px; background:#f1f5f9;">
<style>
  .o_action { overflow-y: auto !important; height: 100% !important; }
  .o_view_controller { overflow-y: auto !important; height: 100% !important; }
  .o_action_manager { overflow-y: auto !important; }
  .o_content { overflow-y: auto !important; height: 100% !important; }

  .o_action { overflow-y: auto !important; height: 100% !important; }
  .o_view_controller { overflow-y: auto !important; height: 100% !important; }
  .o_action_manager { overflow-y: auto !important; }
  .o_content { overflow-y: auto !important; height: 100% !important; }

/* ── Header ── */
.rd-header {
    display:flex; align-items:center; justify-content:space-between;
    flex-wrap:wrap; gap:12px; background:#fff; border-radius:16px;
    padding:16px 24px; margin-bottom:20px;
    border:1px solid #e2e8f0; box-shadow:0 4px 16px rgba(0,0,0,.07);
}
.rd-title { font-size:20px; font-weight:800; color:#1e293b; }
.rd-select-zone, .rd-select-year {
    border-radius:8px; border:1.5px solid #e2e8f0; font-size:13px;
    color:#1e293b; background:#f8fafc; padding:7px 12px;
}
.rd-select-zone { width:220px; }
.rd-select-year { width:120px; font-weight:700; }

/* ── Table wrapper ── */
.rd-table-wrapper {
    background:#fff; border-radius:16px; border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07); overflow:hidden;
}
.rd-table-wrapper.rd-overflow { overflow-x:auto; -webkit-overflow-scrolling:touch; }

/* ── Table ── */
.rd-table { width:100%; border-collapse:collapse; }
.rd-table thead tr { background:linear-gradient(135deg,#1565c0,#6a1b9a); color:#fff; }
.rd-table th { padding:14px 20px; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.6px; text-align:center; }
.rd-table th:first-child { text-align:left; }
.rd-table td { padding:13px 20px; font-size:14px; text-align:center; border-bottom:1px solid #f1f5f9; color:#1e293b; }
.rd-table td:first-child { text-align:left; font-weight:700; color:#475569; }
.rd-table tbody tr:hover td { background:#f8fafc; }
.rd-table tfoot tr { background:linear-gradient(135deg,#f8fafc,#f1f5f9); font-weight:800; }
.rd-table tfoot td { border-top:2px solid #e2e8f0; font-size:14px; }
.rd-clickable { cursor:pointer; color:#1565c0; font-weight:700; text-decoration:underline dotted; }
.rd-clickable:hover { color:#6a1b9a; }
.rd-cell-main  { font-size:14px; font-weight:800; color:#1565c0; }
.rd-cell-jours { font-size:12px; font-weight:600; color:#64748b; margin-left:4px; }
.rd-evo-wrap  { display:inline-flex; flex-direction:row; align-items:center; justify-content:center; gap:6px; flex-wrap:wrap; }
.rd-evo-item  { display:inline-flex; align-items:center; gap:3px; }
.rd-evo-label { font-size:10px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:.4px; }
.rd-badge      { display:inline-block; padding:3px 10px; border-radius:20px; font-size:12px; font-weight:800; color:#fff; }
.rd-badge-up   { background:#16a34a; }
.rd-badge-down { background:#dc2626; }
.rd-badge-null { background:#94a3b8; }

/* ── Bouton retour ── */
.rd-btn-retour {
    display:flex; align-items:center; gap:6px; padding:8px 18px;
    border-radius:9px; border:1.5px solid #e2e8f0; background:#f8fafc;
    color:#475569; font-size:13px; font-weight:600; cursor:pointer;
    transition:background .2s, transform .15s;
}
.rd-btn-retour:hover { background:#e2e8f0; transform:translateY(-2px); }


/* ══════════════════════════════════════════════
   RESPONSIVE — Tablet ≤ 1024px
   ══════════════════════════════════════════════ */
@media (max-width:1024px) {
    .rd-header { flex-direction:column; align-items:flex-start; }
    .rd-title  { font-size:17px; }
    .rd-select-zone { width:180px; }
    .rd-table th,
    .rd-table td { padding:10px 12px; font-size:13px; }
}

/* ══════════════════════════════════════════════
   RESPONSIVE — Mobile ≤ 768px
   ══════════════════════════════════════════════ */
@media (max-width:768px) {
    .rd-header  { padding:12px; border-radius:12px; gap:8px; }
    .rd-title   { font-size:15px; }
    .rd-select-zone { width:100%; }
    .rd-select-year { width:100%; }

    /* Table : scroll horizontal + texte compact */
    .rd-table-wrapper { border-radius:12px; }
    .rd-table th,
    .rd-table td { padding:8px 10px; font-size:12px; }
    .rd-cell-main  { font-size:13px; }
    .rd-cell-jours { font-size:11px; }
    .rd-badge      { font-size:11px; padding:2px 7px; }

    /* Pie grid → 1 colonne */
    .rd-pie-grid { grid-template-columns:1fr !important; }
    .rd-pie-title { font-size:13px; }

    /* Charts */
    canvas { max-height:250px !important; }
}

/* ══════════════════════════════════════════════
   RESPONSIVE — Très petit mobile ≤ 480px
   ══════════════════════════════════════════════ */
@media (max-width:480px) {
    .rd-title  { font-size:13px; }
    .rd-table th,
    .rd-table td { padding:6px 7px; font-size:11px; }
    .rd-cell-main  { font-size:12px; }
    .rd-evo-label  { display:none; }
    canvas { max-height:200px !important; }
}
</style>

<!-- Header -->
<div class="rd-header">
    <div style="display:flex; align-items:center; gap:10px;">
        <button class="rd-btn-retour" t-on-click="retourDashboard">← Retour</button>
        <div class="rd-title">Comparaison mensuelle des réservations</div>
    </div>
    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase;">Année</span>
            <select class="rd-select-year form-select form-select-sm" t-on-change="updateSelectedYear">
                <t t-foreach="state.years" t-as="year" t-key="year">
                    <option t-att-value="year" t-att-selected="state.annee_n == year" t-esc="year"/>
                </t>
            </select>
        </div>
        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase;">Zone</span>
            <select class="rd-select-zone form-select form-select-sm" t-on-change="updateSelectedZone">
                <option value="">🌍 Toutes les zones</option>
                <t t-foreach="state.zones" t-as="zone" t-key="zone.id">
                    <option t-att-value="zone.id" t-att-selected="state.selected_zone == zone.id" t-esc="zone.name"/>
                </t>
            </select>
        </div>
    </div>
</div>

<!-- Loading -->
<t t-if="state.loading">
    <div style="text-align:center; padding:60px; font-size:16px; color:#94a3b8;">⏳ Chargement…</div>
</t>

<t t-else="">
    <div class="rd-table-wrapper">
        <table class="rd-table">
            <thead>
                <tr>
                    <th>Mois</th>
                    <th><t t-esc="state.annee_n1"/></th>
                    <th><t t-esc="state.annee_n"/></th>
                    <th>Évolution</th>
                    <th style="background:rgba(220,38,38,0.85);">
    ❌ Annulations <t t-esc="state.annee_n"/>
</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="state.rows" t-as="row" t-key="row.mois">
                    <tr>
                        <td><t t-esc="row.label"/></td>
                        <td class="rd-clickable" t-att-data-annee="state.annee_n1" t-att-data-mois="row.mois" t-on-click="onClickMois">
                            <span class="rd-cell-main"><t t-esc="row.count_n1"/></span><span class="rd-cell-jours">(<t t-esc="row.jours_n1"/> jours)</span>
                        </td>
                        <td class="rd-clickable" t-att-data-annee="state.annee_n" t-att-data-mois="row.mois" t-on-click="onClickMois">
                            <span class="rd-cell-main"><t t-esc="row.count_n"/></span><span class="rd-cell-jours">(<t t-esc="row.jours_n"/> jours)</span>
                        </td>
                        <td>
                            <div class="rd-evo-wrap">
                                <span class="rd-evo-item">
                                    <span class="rd-evo-label">Résv.</span>
                                    <t t-if="row.delta !== null">
                                        <span t-attf-class="rd-badge {{ row.delta >= 0 ? 'rd-badge-up' : 'rd-badge-down' }}">
                                            <t t-if="row.delta >= 0">▲ +<t t-esc="row.delta"/> %</t>
                                            <t t-else="">▼ <t t-esc="row.delta"/> %</t>
                                        </span>
                                    </t>
                                    <t t-else=""><span class="rd-badge rd-badge-null">—</span></t>
                                </span>
                                <span style="color:#e2e8f0;">|</span>
                                <span class="rd-evo-item">
                                    <span class="rd-evo-label">Jours</span>
                                    <t t-if="row.delta_jours !== null">
                                        <span t-attf-class="rd-badge {{ row.delta_jours >= 0 ? 'rd-badge-up' : 'rd-badge-down' }}">
                                            <t t-if="row.delta_jours >= 0">▲ +<t t-esc="row.delta_jours"/> %</t>
                                            <t t-else="">▼ <t t-esc="row.delta_jours"/> %</t>
                                        </span>
                                    </t>
                                    <t t-else=""><span class="rd-badge rd-badge-null">—</span></t>
                                </span>
                            </div>
                        </td>
                        <td>
    <span class="rd-cell-main" style="color:#dc2626;">
        <t t-esc="totalAnnuleN"/>
    </span>
    <span class="rd-cell-jours">(<t t-esc="totalJoursAnnuleN"/> jours)</span>
</td>
                    </tr>
                </t>
            </tbody>
            <tfoot>
                <tr>
                    <td>Total</td>
                    <td>
                        <span class="rd-cell-main"><t t-esc="totalN1"/></span><span class="rd-cell-jours">(<t t-esc="totalJoursN1"/> jours)</span>
                    </td>
                    <td>
                        <span class="rd-cell-main"><t t-esc="totalN"/></span><span class="rd-cell-jours">(<t t-esc="totalJoursN"/> jours)</span>
                    </td>
                    <td>
                        <div class="rd-evo-wrap">
                            <div>
                                <span class="rd-evo-label">Résv.</span>
                                <t t-if="totalDelta !== null">
                                    <span t-attf-class="rd-badge {{ totalDelta >= 0 ? 'rd-badge-up' : 'rd-badge-down' }}">
                                        <t t-if="totalDelta >= 0">▲ +<t t-esc="totalDelta"/> %</t>
                                        <t t-else="">▼ <t t-esc="totalDelta"/> %</t>
                                    </span>
                                </t>
                            </div>
                            <div>
                                <span class="rd-evo-label">Jours</span>
                                <t t-if="totalDeltaJours !== null">
                                    <span t-attf-class="rd-badge {{ totalDeltaJours >= 0 ? 'rd-badge-up' : 'rd-badge-down' }}">
                                        <t t-if="totalDeltaJours >= 0">▲ +<t t-esc="totalDeltaJours"/> %</t>
                                        <t t-else="">▼ <t t-esc="totalDeltaJours"/> %</t>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Graphique barres -->
    <div class="rd-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:16px;">
            📊 Comparaison mensuelle — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>
        <canvas id="rd-chart" style="width:100%; max-height:400px;"/>
    </div>

    <!-- Graphique courbe -->
    <div class="rd-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:16px;">
            📈 Évolution mensuelle — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>

        <canvas id="rd-chart-line" style="width:100%; max-height:400px;"/>
    </div>


    <!-- ── Graphique : Moyenne Jours / Réservation par mois ── -->
    <div class="rd-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:4px;">
            📊 Moyenne jours / réservation — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>
        <div style="font-size:12px; color:#94a3b8; margin-bottom:16px;">
            Nombre de jours total ÷ nombre de réservations, par mois
        </div>
        <canvas id="rd-chart-ratio" style="width:100%; max-height:400px;"/>
    </div>

</t>

</div>
    </t>


    <!-- ═══════════════════════════════════════════════════════════
         PAGE DÉTAIL — tableau croisé groupé par ZONE + expand/collapse
         ═══════════════════════════════════════════════════════════ -->
    <t t-name="dashboard_analytics.ReservationDetailDashboard">
<div style="padding:16px; background:#f1f5f9; min-height:100vh; overflow-y:auto;">
<style>
.o_action { overflow-y: auto !important; height: 100% !important; }
.o_view_controller { overflow-y: auto !important; height: 100% !important; }
.o_action_manager { overflow-y: auto !important; }
.o_content { overflow-y: auto !important; height: 100% !important; }

/* ── Header ── */
.rdd-header {
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;
    background:#fff; border-radius:16px; padding:16px 24px; margin-bottom:20px;
    border:1px solid #e2e8f0; box-shadow:0 4px 16px rgba(0,0,0,.07);
}
.rdd-title   { font-size:18px; font-weight:800; color:#1e293b; }
.rdd-subtitle { font-size:13px; color:#64748b; font-weight:500; margin-top:2px; }
.rdd-btn {
    display:flex; align-items:center; gap:6px; padding:8px 18px;
    border-radius:9px; border:1.5px solid #e2e8f0; background:#f8fafc;
    color:#475569; font-size:13px; font-weight:600; cursor:pointer;
    transition:background .2s, transform .15s;
}
.rdd-btn:hover { background:#e2e8f0; transform:translateY(-2px); }

/* ── Cards ── */
.rdd-card {
    background:#fff; border-radius:16px; border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07); overflow:hidden; margin-bottom:20px;
}
.rdd-card-title {
    font-size:15px; font-weight:800; color:#1e293b;
    padding:18px 24px 12px; border-bottom:1px solid #f1f5f9;
}
.rdd-scroll { overflow-x:auto; -webkit-overflow-scrolling:touch; }

/* ── Tableau croisé ── */
.rdd-cross-table { width:100%; border-collapse:collapse; font-size:13px; }
.rdd-cross-table thead tr { background:linear-gradient(135deg,#1565c0,#6a1b9a); color:#fff; }
.rdd-cross-table thead th {
    padding:12px 16px; font-weight:700; text-transform:uppercase;
    letter-spacing:.5px; text-align:center; white-space:nowrap;
}
.rdd-cross-table thead th:first-child { text-align:left; }

.rdd-zone-row {
    background:linear-gradient(90deg,#eef2ff 0%,#f5f3ff 100%);
    cursor:pointer; user-select:none; border-bottom:1px solid #c7d2fe;
}
.rdd-zone-row:hover { background:linear-gradient(90deg,#e0e7ff 0%,#ede9fe 100%); }
.rdd-zone-row td {
    padding:11px 16px; font-weight:800; font-size:13px;
    color:#3730a3; border-bottom:1px solid #c7d2fe;
}
.rdd-zone-row td:first-child {
    text-align:left; white-space:nowrap; position:sticky; left:0; z-index:2;
    background:linear-gradient(90deg,#eef2ff 0%,#f5f3ff 100%);
    border-right:1px solid #c7d2fe;
}
.rdd-zone-toggle { display:inline-flex; align-items:center; gap:8px; }
.rdd-zone-arrow  { display:inline-block; font-size:11px; transition:transform .2s ease; color:#6366f1; }
.rdd-zone-arrow.open { transform:rotate(90deg); }
.rdd-zone-cell-count { font-weight:800; color:#4f46e5; font-size:14px; }
.rdd-zone-cell-jours { font-size:11px; color:#818cf8; font-weight:500; }
.rdd-zone-total-col  { background:#ede9fe !important; border-left:2px solid #c4b5fd !important; }

.rdd-lieu-row td {
    padding:9px 16px; text-align:center; border-bottom:1px solid #f1f5f9;
    color:#1e293b; font-size:13px;
}
.rdd-lieu-row td:first-child {
    text-align:left; font-weight:600; color:#475569; background:#fafafa;
    white-space:nowrap; position:sticky; left:0; z-index:2;
    border-right:1px solid #e2e8f0; padding-left:32px;
}
.rdd-lieu-row:hover td           { background:#f0f7ff; }
.rdd-lieu-row:hover td:first-child { background:#e8f0fe; }

.rdd-cell-count { font-weight:800; color:#1565c0; font-size:14px; }
.rdd-cell-jours { font-size:11px; color:#94a3b8; font-weight:500; }
.rdd-cell-empty { color:#e2e8f0; font-size:18px; }

.rdd-total-row td {
    background:linear-gradient(135deg,#f8fafc,#f1f5f9) !important;
    font-weight:800 !important; border-top:2px solid #e2e8f0 !important;
    font-size:13px; padding:11px 16px; text-align:center;
}
.rdd-total-row td:first-child { text-align:left; }
.rdd-total-col { background:#f8fafc !important; border-left:2px solid #e2e8f0 !important; }

/* ── Grilles charts ── */
.rdd-charts-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
.rdd-trio-grid   { display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px; margin-bottom:20px; }

/* ── Chart title ── */
.rdd-chart-title { font-size:14px; font-weight:700; color:#475569; padding:16px 20px 12px; border-bottom:1px solid #f1f5f9; }

/* ── Heatmap légende ── */
.rdd-heatmap-legend {
    display:flex; align-items:center; gap:8px; font-size:11px;
    color:#64748b; font-weight:600; padding:12px 20px 16px;
}
.rdd-heatmap-legend-bar {
    width:120px; height:12px; border-radius:6px;
    background:linear-gradient(to right,#f1f5f9,#bae6fd,#1565c0,#6a1b9a);
}

/* ══════════════════════════════════════════════
   RESPONSIVE — Tablet ≤ 1024px
   ══════════════════════════════════════════════ */
@media (max-width:1024px) {
    /* Header : badge total passe en dessous */
    .rdd-header { flex-direction:column; align-items:flex-start; }

    /* 3 colonnes → 2 colonnes */
    .rdd-trio-grid { grid-template-columns:1fr 1fr !important; }

    /* Tableau : font plus petite */
    .rdd-cross-table { font-size:12px; }
    .rdd-cross-table thead th,
    .rdd-zone-row td,
    .rdd-lieu-row td,
    .rdd-total-row td { padding:8px 10px; }
    .rdd-zone-cell-count,
    .rdd-cell-count { font-size:13px; }
}

/* ══════════════════════════════════════════════
   RESPONSIVE — Mobile ≤ 768px
   ══════════════════════════════════════════════ */
@media (max-width:768px) {
    /* Padding global réduit */
    div[style*="padding:16px"] { padding:8px !important; }

    /* Header simplifié */
    .rdd-header { padding:12px; gap:8px; border-radius:12px; }
    .rdd-title  { font-size:15px; }
    .rdd-subtitle { font-size:11px; }

    /* Cards */
    .rdd-card { border-radius:12px; margin-bottom:12px; }
    .rdd-card-title { font-size:13px; padding:12px 14px 10px; }

    /* Toutes les grilles → 1 colonne */
    .rdd-charts-grid { grid-template-columns:1fr !important; gap:12px; }
    .rdd-trio-grid   { grid-template-columns:1fr !important; gap:12px; }

    /* Tableau croisé : encore plus compact */
    .rdd-cross-table { font-size:11px; }
    .rdd-cross-table thead th,
    .rdd-zone-row td,
    .rdd-lieu-row td,
    .rdd-total-row td { padding:6px 8px; }
    .rdd-zone-cell-count,
    .rdd-cell-count { font-size:12px; }
    .rdd-zone-cell-jours,
    .rdd-cell-jours { font-size:10px; }

    /* Lieu : moins d'indentation */
    .rdd-lieu-row td:first-child { padding-left:20px; }

    /* Charts : hauteur réduite sur mobile */
    canvas { max-height:220px !important; }

    /* Heatmap légende */
    .rdd-heatmap-legend { padding:8px 14px 10px; }
    .rdd-heatmap-legend-bar { width:80px; }

    /* Chart title */
    .rdd-chart-title { font-size:12px; padding:10px 14px 8px; }
}

/* ══════════════════════════════════════════════
   RESPONSIVE — Très petit mobile ≤ 480px
   ══════════════════════════════════════════════ */
@media (max-width:480px) {
    .rdd-title  { font-size:14px; }
    .rdd-cross-table { font-size:10px; }
    .rdd-cross-table thead th,
    .rdd-zone-row td,
    .rdd-lieu-row td,
    .rdd-total-row td { padding:5px 6px; }
    canvas { max-height:180px !important; }
}
</style>

    <!-- Header -->
    <div class="rdd-header">
        <div>
            <button class="rdd-btn" t-on-click="retour">← Retour</button>
        </div>
        <div style="flex:1; padding:0 16px;">
            <div class="rdd-title">📋 Détail des réservations</div>
            <div class="rdd-subtitle"><t t-esc="state.label"/></div>
        </div>
        <div style="
            position:relative; overflow:hidden;
            background:linear-gradient(135deg,#1565c0 0%,#1e40af 100%);
            border-radius:16px; padding:18px 28px 18px 22px; min-width:180px;
            box-shadow:0 8px 32px rgba(21,101,192,0.35), inset 0 1px 0 rgba(255,255,255,0.15);
        ">
            <div style="font-size:11px; font-weight:700; color:rgba(255,255,255,0.65); text-transform:uppercase; letter-spacing:1.2px; margin-bottom:6px;">Réservations</div>
            <div style="font-size:32px; font-weight:900; color:#fff; line-height:1; letter-spacing:-1px;">
                <t t-esc="state.grand_total.count"/>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <t t-if="state.loading">
        <div style="text-align:center; padding:80px; font-size:16px; color:#94a3b8;">⏳ Chargement des données…</div>
    </t>

    <t t-else="">

        <!-- ── Tableau croisé groupé par Zone ── -->
        <div class="rdd-card">
            <div class="rdd-card-title">
                🔀 Tableau croisé — Zones / Lieux × Catégories de client
                <span style="font-size:12px; font-weight:500; color:#94a3b8; margin-left:8px;">
                    (cliquez sur une zone pour voir ses lieux)
                </span>
            </div>
            <div class="rdd-scroll">
                <table class="rdd-cross-table">
                    <thead>
                        <tr>
                            <th style="min-width:200px;">Zone / Lieu de départ</th>
                            <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                <th><t t-esc="cat.name"/></th>
                            </t>
                            <th style="background:rgba(255,255,255,0.15);">Total</th>
                        </tr>
                    </thead>
                    <tbody>

                        <!-- Boucle sur les ZONES -->
                        <t t-foreach="state.zones" t-as="zone" t-key="zone.id">

                            <!-- ── Ligne ZONE (résumé, cliquable) ── -->
                            <tr class="rdd-zone-row" t-on-click="() => this.toggleZone(zone.id)">
                                <td>
                                    <span class="rdd-zone-toggle">
                                        <span t-attf-class="rdd-zone-arrow {{ isZoneExpanded(zone.id) ? 'open' : '' }}">▶</span>
                                        🗺️ <t t-esc="zone.name"/>
                                    </span>
                                </td>
                                <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                    <td>
                                        <t t-set="cz" t-value="getCellZone(zone.id, cat.id)"/>
                                        <t t-if="cz.count > 0">
                                            <div class="rdd-zone-cell-count"><t t-esc="cz.count"/></div>
                                            <div class="rdd-zone-cell-jours">(<t t-esc="cz.jours"/> j)</div>
                                        </t>
                                        <t t-else=""><span class="rdd-cell-empty">·</span></t>
                                    </td>
                                </t>
                                <td class="rdd-zone-total-col">
                                    <t t-set="tz" t-value="getTotalZone(zone.id)"/>
                                    <div class="rdd-zone-cell-count"><t t-esc="tz.count"/></div>
                                    <div class="rdd-zone-cell-jours">(<t t-esc="tz.jours"/> j)</div>
                                </td>
                            </tr>

                            <!-- ── Lignes LIEUX (visibles si zone expanded) ── -->
                            <t t-if="isZoneExpanded(zone.id)">
                                <t t-foreach="getLieuxByZone(zone.id)" t-as="lieu" t-key="lieu.id">
                                    <tr class="rdd-lieu-row">
                                        <td>📍 <t t-esc="lieu.name"/></td>
                                        <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                            <td>
                                                <t t-set="cell" t-value="getCellLieu(lieu.id, cat.id)"/>
                                                <t t-if="cell.count > 0">
                                                    <div class="rdd-cell-count"><t t-esc="cell.count"/></div>
                                                    <div class="rdd-cell-jours">(<t t-esc="cell.jours"/> j)</div>
                                                </t>
                                                <t t-else=""><span class="rdd-cell-empty">·</span></t>
                                            </td>
                                        </t>
                                        <td class="rdd-total-col">
                                            <t t-set="tl" t-value="getTotalLieu(lieu.id)"/>
                                            <div class="rdd-cell-count"><t t-esc="tl.count"/></div>
                                            <div class="rdd-cell-jours">(<t t-esc="tl.jours"/> j)</div>
                                        </td>
                                    </tr>
                                </t>
                            </t>

                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="rdd-total-row">
                            <td>Total général</td>
                            <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                <td>
                                    <t t-set="tc" t-value="getTotalCat(cat.id)"/>
                                    <div class="rdd-cell-count"><t t-esc="tc.count"/></div>
                                    <div class="rdd-cell-jours">(<t t-esc="tc.jours"/> j)</div>
                                </td>
                            </t>
                            <td class="rdd-total-col">
                                <div class="rdd-cell-count" style="color:#6a1b9a;">
                                    <t t-esc="state.grand_total.count"/>
                                </div>
                                <div class="rdd-cell-jours">(<t t-esc="state.grand_total.jours"/> j)</div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Graphiques réservations -->
        <div class="rdd-charts-grid">
            <div class="rdd-card">
                <div class="rdd-chart-title">📍 Par lieu de départ</div>
                <div style="padding:20px;">
                    <canvas id="rdd-chart-lieux" style="width:100%; max-height:380px;"/>
                </div>
            </div>
            <div class="rdd-card">
                <div class="rdd-chart-title">🏷️ Par catégorie de client</div>
                <div style="padding:20px;">
                    <canvas id="rdd-chart-categories" style="width:100%; max-height:380px;"/>
                </div>
            </div>
        </div>

        <!-- Graphiques moyenne jours/résv -->
        <div class="rdd-charts-grid">
            <div class="rdd-card">
                <div class="rdd-chart-title">📍 Moyenne jours/résv — Par lieu de départ</div>
                <div style="font-size:11px; color:#94a3b8; padding:0 20px 8px; font-weight:500;">
                    Nbre de jours ÷ nbre de réservations
                </div>
                <div style="padding:0 20px 20px;">
                    <canvas id="rdd-chart-lieux-moy" style="width:100%; max-height:380px;"/>
                </div>
            </div>
            <div class="rdd-card">
                <div class="rdd-chart-title">🏷️ Moyenne jours/résv — Par catégorie de client</div>
                <div style="font-size:11px; color:#94a3b8; padding:0 20px 8px; font-weight:500;">
                    Nbre de jours ÷ nbre de réservations
                </div>
                <div style="padding:0 20px 20px;">
                    <canvas id="rdd-chart-categories-moy" style="width:100%; max-height:380px;"/>
                </div>
            </div>
        </div>

        <!-- ══════════════════════════════════════════════════════════
             NOUVEAUX 1, 2, 3 — sur la même ligne (3 colonnes)
             ══════════════════════════════════════════════════════════ -->
        <div class="rdd-trio-grid" style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px; margin-bottom:20px;">

            <!-- 1 — Réservations par jour de la semaine -->
            <div class="rdd-card" style="margin-bottom:0;">
                <div class="rdd-chart-title">
                    📅 Par jour de la semaine
                    <div style="font-size:11px; color:#94a3b8; font-weight:500; margin-top:2px;">Tous les mois confondus</div>
                </div>
                <div style="padding:16px;">
                    <canvas id="rdd-chart-jour-semaine" style="width:100%; max-height:300px;"/>
                </div>
            </div>

            <!-- 2 — Heatmap semaine × jour -->
            <div class="rdd-card" style="margin-bottom:0;">
                <div class="rdd-chart-title">🗓️ Heatmap — semaine × jour</div>
                <div class="rdd-heatmap-legend">
                    <span>Faible</span>
                    <div class="rdd-heatmap-legend-bar"/>
                    <span>Élevé</span>
                </div>
                <div id="rdd-heatmap-container" style="padding:0 16px 16px; overflow-x:auto;"/>
            </div>

            <!-- 3 — Distribution des durées -->
            <div class="rdd-card" style="margin-bottom:0;">
                <div class="rdd-chart-title">
                    📏 Distribution des durées
                    <div style="font-size:11px; color:#94a3b8; font-weight:500; margin-top:2px;">Nb réservations selon la durée (jours)</div>
                </div>
                <div style="padding:16px;">
                    <canvas id="rdd-chart-distribution-durees" style="width:100%; max-height:300px;"/>
                </div>
            </div>

        </div>

    </t>

</div>
    </t>

</templates>