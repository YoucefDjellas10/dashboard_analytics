<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- TEMPLATE DASHBOARD PRINCIPAL (inchangé) -->
    <t t-name="dashboard_analytics.ReservationDashboard">
<div style="padding:16px; background:#f1f5f9;">
<style>
  .o_action {
    overflow-y: auto !important;
    height: 100% !important;
  }
  .o_view_controller {
    overflow-y: auto !important;
    height: 100% !important;
  }
  .o_action_manager {
    overflow-y: auto !important;
  }
  .o_content {
    overflow-y: auto !important;
    height: 100% !important;
  }

.rd-header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:12px;
    background:#fff;
    border-radius:16px;
    padding:16px 24px;
    margin-bottom:20px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
}
.rd-title {
    font-size:20px;
    font-weight:800;
    color:#1e293b;
}
.rd-select-zone,
.rd-select-year {
    border-radius:8px;
    border:1.5px solid #e2e8f0;
    font-size:13px;
    color:#1e293b;
    background:#f8fafc;
    padding:7px 12px;
}
.rd-select-zone { width:220px; }
.rd-select-year { width:120px; font-weight:700; }
.rd-table-wrapper {
    background:#fff;
    border-radius:16px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
    overflow:hidden;
}
.rd-table {
    width:100%;
    border-collapse:collapse;
}
.rd-table thead tr {
    background:linear-gradient(135deg,#1565c0,#6a1b9a);
    color:#fff;
}
.rd-table th {
    padding:14px 20px;
    font-size:13px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.6px;
    text-align:center;
}
.rd-table th:first-child { text-align:left; }
.rd-table td {
    padding:13px 20px;
    font-size:14px;
    text-align:center;
    border-bottom:1px solid #f1f5f9;
    color:#1e293b;
}
.rd-table td:first-child {
    text-align:left;
    font-weight:700;
    color:#475569;
}
.rd-table tbody tr:hover td {
    background:#f8fafc;
}
.rd-table tfoot tr {
    background:linear-gradient(135deg,#f8fafc,#f1f5f9);
    font-weight:800;
}
.rd-table tfoot td {
    border-top:2px solid #e2e8f0;
    font-size:14px;
}
.rd-clickable {
    cursor:pointer;
    color:#1565c0;
    font-weight:700;
    text-decoration:underline dotted;
}
.rd-clickable:hover { color:#6a1b9a; }

.rd-cell-main {
    font-size:14px;
    font-weight:800;
    color:#1565c0;
}
.rd-cell-jours {
    font-size:12px;
    font-weight:600;
    color:#64748b;
    margin-left:4px;
}

.rd-evo-wrap {
    display:inline-flex;
    flex-direction:row;
    align-items:center;
    justify-content:center;
    gap:6px;
    flex-wrap:wrap;
}
.rd-evo-item {
    display:inline-flex;
    align-items:center;
    gap:3px;
}
.rd-evo-label {
    font-size:10px;
    font-weight:600;
    color:#94a3b8;
    text-transform:uppercase;
    letter-spacing:.4px;
}
.rd-badge {
    display:inline-block;
    padding:3px 10px;
    border-radius:20px;
    font-size:12px;
    font-weight:800;
    color:#fff;
}
.rd-badge-up   { background:#16a34a; }
.rd-badge-down { background:#dc2626; }
.rd-badge-null { background:#94a3b8; }

.rd-btn-retour {
    display:flex;
    align-items:center;
    gap:6px;
    padding:8px 18px;
    border-radius:9px;
    border:1.5px solid #e2e8f0;
    background:#f8fafc;
    color:#475569;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    transition:background .2s, transform .15s;
}
.rd-btn-retour:hover {
    background:#e2e8f0;
    transform:translateY(-2px);
}
.rd-pie-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 20px;
}
@media (max-width: 900px) {
    .rd-pie-grid { grid-template-columns: 1fr; }
}
.rd-pie-title {
    font-size:15px;
    font-weight:800;
    color:#1e293b;
    margin-bottom:16px;
    text-align:center;
}
</style>

<!-- Header -->
<div class="rd-header">
    <div style="display:flex; align-items:center; gap:10px;">
        <button class="rd-btn-retour" t-on-click="retourDashboard">
            ← Retour
        </button>
        <div class="rd-title">
          Comparaison mensuelle des réservations
        </div>
    </div>

    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase;">Année</span>
            <select class="rd-select-year form-select form-select-sm"
                    t-on-change="updateSelectedYear">
                <t t-foreach="state.years" t-as="year" t-key="year">
                    <option t-att-value="year"
                            t-att-selected="state.annee_n == year"
                            t-esc="year"/>
                </t>
            </select>
        </div>
        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase;">Zone</span>
            <select class="rd-select-zone form-select form-select-sm"
                    t-on-change="updateSelectedZone">
                <option value="">🌍 Toutes les zones</option>
                <t t-foreach="state.zones" t-as="zone" t-key="zone.id">
                    <option t-att-value="zone.id"
                            t-att-selected="state.selected_zone == zone.id"
                            t-esc="zone.name"/>
                </t>
            </select>
        </div>
    </div>
</div>

<!-- Loading -->
<t t-if="state.loading">
    <div style="text-align:center; padding:60px; font-size:16px; color:#94a3b8;">
        ⏳ Chargement…
    </div>
</t>

<!-- Tableau -->
<t t-else="">
    <div class="rd-table-wrapper">
        <table class="rd-table">
            <thead>
                <tr>
                    <th>Mois</th>
                    <th><t t-esc="state.annee_n1"/></th>
                    <th><t t-esc="state.annee_n"/></th>
                    <th>Évolution</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="state.rows" t-as="row" t-key="row.mois">
                    <tr>
                        <td><t t-esc="row.label"/></td>

                        <td class="rd-clickable"
                            t-att-data-annee="state.annee_n1"
                            t-att-data-mois="row.mois"
                            t-on-click="onClickMois">
                            <span class="rd-cell-main"><t t-esc="row.count_n1"/></span><span class="rd-cell-jours">(<t t-esc="row.jours_n1"/> jours)</span>
                        </td>

                        <td class="rd-clickable"
                            t-att-data-annee="state.annee_n"
                            t-att-data-mois="row.mois"
                            t-on-click="onClickMois">
                            <span class="rd-cell-main"><t t-esc="row.count_n"/></span><span class="rd-cell-jours">(<t t-esc="row.jours_n"/> jours)</span>
                        </td>

                        <td>
                            <div class="rd-evo-wrap">
                                <span class="rd-evo-item">
                                    <span class="rd-evo-label">Résv.</span>
                                    <t t-if="row.delta !== null">
                                        <span t-attf-class="rd-badge {{ row.delta >= 0 ? 'rd-badge-up' : 'rd-badge-down' }}">
                                            <t t-if="row.delta >= 0">▲ +<t t-esc="row.delta"/> %</t>
                                            <t t-else="">▼ <t t-esc="row.delta"/> %</t>
                                        </span>
                                    </t>
                                    <t t-else=""><span class="rd-badge rd-badge-null">—</span></t>
                                </span>
                                <span style="color:#e2e8f0;">|</span>
                                <span class="rd-evo-item">
                                    <span class="rd-evo-label">Jours</span>
                                    <t t-if="row.delta_jours !== null">
                                        <span t-attf-class="rd-badge {{ row.delta_jours >= 0 ? 'rd-badge-up' : 'rd-badge-down' }}">
                                            <t t-if="row.delta_jours >= 0">▲ +<t t-esc="row.delta_jours"/> %</t>
                                            <t t-else="">▼ <t t-esc="row.delta_jours"/> %</t>
                                        </span>
                                    </t>
                                    <t t-else=""><span class="rd-badge rd-badge-null">—</span></t>
                                </span>
                            </div>
                        </td>
                    </tr>
                </t>
            </tbody>
            <tfoot>
                <tr>
                    <td>Total</td>
                    <td>
                        <span class="rd-cell-main"><t t-esc="totalN1"/></span><span class="rd-cell-jours">(<t t-esc="totalJoursN1"/> jours)</span>
                    </td>
                    <td>
                        <span class="rd-cell-main"><t t-esc="totalN"/></span><span class="rd-cell-jours">(<t t-esc="totalJoursN"/> jours)</span>
                    </td>
                    <td>
                        <div class="rd-evo-wrap">
                            <div>
                                <span class="rd-evo-label">Résv.</span>
                                <t t-if="totalDelta !== null">
                                    <span t-attf-class="rd-badge {{ totalDelta >= 0 ? 'rd-badge-up' : 'rd-badge-down' }}">
                                        <t t-if="totalDelta >= 0">▲ +<t t-esc="totalDelta"/> %</t>
                                        <t t-else="">▼ <t t-esc="totalDelta"/> %</t>
                                    </span>
                                </t>
                            </div>
                            <div>
                                <span class="rd-evo-label">Jours</span>
                                <t t-if="totalDeltaJours !== null">
                                    <span t-attf-class="rd-badge {{ totalDeltaJours >= 0 ? 'rd-badge-up' : 'rd-badge-down' }}">
                                        <t t-if="totalDeltaJours >= 0">▲ +<t t-esc="totalDeltaJours"/> %</t>
                                        <t t-else="">▼ <t t-esc="totalDeltaJours"/> %</t>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Graphique barres -->
    <div class="rd-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:16px;">
            📊 Comparaison mensuelle — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>
        <canvas id="rd-chart" style="width:100%; max-height:400px;"/>
    </div>

    <!-- Graphique courbe -->
    <div class="rd-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:16px;">
            📈 Évolution mensuelle — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>
        <canvas id="rd-chart-line" style="width:100%; max-height:400px;"/>
    </div>

    <!-- Graphiques Pie côte à côte -->
    <div class="rd-pie-grid">
        <div class="rd-table-wrapper" style="padding:24px;">
            <div class="rd-pie-title">
                🥧 Réservations par zone — <t t-esc="state.annee_n1"/>
            </div>
            <canvas id="rd-chart-pie-n1" style="width:100%; max-height:500px;"/>
        </div>
        <div class="rd-table-wrapper" style="padding:24px;">
            <div class="rd-pie-title">
                🥧 Réservations par zone — <t t-esc="state.annee_n"/>
            </div>
            <canvas id="rd-chart-pie" style="width:100%; max-height:500px;"/>
        </div>
    </div>

</t>

</div>
    </t>


    <!-- ═══════════════════════════════════════════════════════════
         PAGE DÉTAIL — Tableau ACCORDÉON Zone → Lieux
         ═══════════════════════════════════════════════════════════ -->
    <t t-name="dashboard_analytics.ReservationDetailDashboard">
<div style="padding:16px; background:#f1f5f9; min-height:100vh; overflow-y:auto;">
<style>
.o_action {
    overflow-y: auto !important;
    height: 100% !important;
}
.o_view_controller {
    overflow-y: auto !important;
    height: 100% !important;
}
.o_action_manager {
    overflow-y: auto !important;
}
.o_content {
    overflow-y: auto !important;
    height: 100% !important;
}

.rdd-header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:12px;
    background:#fff;
    border-radius:16px;
    padding:16px 24px;
    margin-bottom:20px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
}
.rdd-title {
    font-size:18px;
    font-weight:800;
    color:#1e293b;
}
.rdd-subtitle {
    font-size:13px;
    color:#64748b;
    font-weight:500;
    margin-top:2px;
}
.rdd-btn {
    display:flex;
    align-items:center;
    gap:6px;
    padding:8px 18px;
    border-radius:9px;
    border:1.5px solid #e2e8f0;
    background:#f8fafc;
    color:#475569;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    transition:background .2s, transform .15s;
}
.rdd-btn:hover {
    background:#e2e8f0;
    transform:translateY(-2px);
}
.rdd-card {
    background:#fff;
    border-radius:16px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
    overflow:hidden;
    margin-bottom:20px;
}
.rdd-card-title {
    font-size:15px;
    font-weight:800;
    color:#1e293b;
    padding:18px 24px 12px;
    border-bottom:1px solid #f1f5f9;
}
.rdd-scroll {
    overflow-x: auto;
}
.rdd-cross-table {
    width:100%;
    border-collapse:collapse;
    font-size:13px;
}
.rdd-cross-table thead tr:first-child {
    background:linear-gradient(135deg,#1565c0,#6a1b9a);
    color:#fff;
}
.rdd-cross-table thead tr:first-child th {
    padding:12px 16px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.5px;
    text-align:center;
    white-space:nowrap;
}
.rdd-cross-table thead tr:first-child th:first-child {
    text-align:left;
}
.rdd-cross-table tbody td {
    padding:10px 14px;
    text-align:center;
    border-bottom:1px solid #f1f5f9;
    color:#1e293b;
    vertical-align:middle;
}
.rdd-cross-table tbody td:first-child {
    text-align:left;
    font-weight:700;
    white-space:nowrap;
}
.rdd-cross-table tbody tr:hover td {
    background:#f0f7ff;
}
.rdd-cell-count {
    font-weight:800;
    color:#1565c0;
    font-size:14px;
}
.rdd-cell-jours {
    font-size:11px;
    color:#94a3b8;
    font-weight:500;
}
.rdd-total-row td {
    background:linear-gradient(135deg,#f8fafc,#f1f5f9) !important;
    font-weight:800 !important;
    border-top:2px solid #e2e8f0 !important;
    font-size:13px;
}
.rdd-total-col {
    background:#f8fafc !important;
    font-weight:800 !important;
    border-left:2px solid #e2e8f0 !important;
}
.rdd-cell-empty {
    color:#e2e8f0;
    font-size:18px;
}
.rdd-zone-row {
    background:#f8fafc;
    cursor:pointer;
    transition:background .2s;
}
.rdd-zone-row:hover {
    background:#e8f0fe !important;
}
.rdd-zone-row td:first-child {
    font-weight:800;
    color:#1e293b;
}
.rdd-lieu-row td:first-child {
    padding-left:32px !important;
    font-weight:600;
    color:#64748b;
}
.rdd-expand-icon {
    display:inline-block;
    margin-right:8px;
    font-size:12px;
    transition:transform .2s;
}
.rdd-charts-grid {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}
@media (max-width:900px) {
    .rdd-charts-grid { grid-template-columns:1fr; }
}
.rdd-chart-title {
    font-size:14px;
    font-weight:700;
    color:#475569;
    padding:16px 20px 12px;
    border-bottom:1px solid #f1f5f9;
}
</style>

    <!-- Header -->
    <div class="rdd-header">
        <div>
            <button class="rdd-btn" t-on-click="retour">← Retour</button>
        </div>
        <div style="flex:1; padding: 0 16px;">
            <div class="rdd-title">📋 Détail des réservations</div>
            <div class="rdd-subtitle"><t t-esc="state.label"/></div>
        </div>
        <div style="display:flex; gap:14px; flex-wrap:wrap; align-items:center;">
            <div style="
                position:relative;
                overflow:hidden;
                background:linear-gradient(135deg,#1565c0 0%,#1e40af 100%);
                border-radius:16px;
                padding:18px 28px 18px 22px;
                min-width:180px;
                box-shadow:0 8px 32px rgba(21,101,192,0.35), inset 0 1px 0 rgba(255,255,255,0.15);
            ">
                <div style="
                    position:absolute; top:-18px; right:-18px;
                    width:80px; height:80px;
                    border-radius:50%;
                    background:rgba(255,255,255,0.08);
                    pointer-events:none;
                "/>
                <div style="
                    position:absolute; bottom:-28px; right:14px;
                    width:56px; height:56px;
                    border-radius:50%;
                    background:rgba(255,255,255,0.05);
                    pointer-events:none;
                "/>
                <div style="font-size:11px; font-weight:700; color:rgba(255,255,255,0.65); text-transform:uppercase; letter-spacing:1.2px; margin-bottom:6px;">
                    Réservations
                </div>
                <div style="font-size:32px; font-weight:900; color:#fff; line-height:1; letter-spacing:-1px;">
                    <t t-esc="state.grand_total.count"/>
                </div>
                <div style="margin-top:8px; display:flex; align-items:center; gap:5px;">
                    <div style="width:24px; height:2px; background:rgba(255,255,255,0.4); border-radius:2px;"/>
                    <div style="width:8px; height:2px; background:rgba(255,255,255,0.2); border-radius:2px;"/>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <t t-if="state.loading">
        <div style="text-align:center; padding:80px; font-size:16px; color:#94a3b8;">
            ⏳ Chargement des données…
        </div>
    </t>

    <t t-else="">
        <div class="rdd-card">
            <div class="rdd-card-title">
                🔀 Tableau croisé — Zones × Catégories de client (cliquez sur une zone pour voir les lieux)
            </div>
            <div class="rdd-scroll">
                <table class="rdd-cross-table">
                    <thead>
                        <tr>
                            <th style="min-width:200px;">Zone / Lieu</th>
                            <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                <th><t t-esc="cat.name"/></th>
                            </t>
                            <th style="background:rgba(255,255,255,0.15);">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.zones" t-as="zone" t-key="zone.id">
                            <!-- Ligne ZONE (accordéon) -->
                            <tr class="rdd-zone-row" t-on-click="() => toggleZone(zone.id)">
                                <td>
                                    <span class="rdd-expand-icon">
                                        <t t-if="isZoneExpanded(zone.id)">▼</t>
                                        <t t-else="">▶</t>
                                    </span>
                                    <strong>🏢 <t t-esc="zone.name"/></strong>
                                </td>
                                <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                    <td>
                                        <t t-set="cell" t-value="getCellZone(zone.id, cat.id)"/>
                                        <t t-if="cell.count > 0">
                                            <div class="rdd-cell-count"><t t-esc="cell.count"/></div>
                                            <div class="rdd-cell-jours">(<t t-esc="cell.jours"/> j)</div>
                                        </t>
                                        <t t-else="">
                                            <span class="rdd-cell-empty">·</span>
                                        </t>
                                    </td>
                                </t>
                                <td class="rdd-total-col">
                                    <t t-set="tz" t-value="getZoneTotal(zone.id)"/>
                                    <div class="rdd-cell-count"><t t-esc="tz.count"/></div>
                                    <div class="rdd-cell-jours">(<t t-esc="tz.jours"/> j)</div>
                                </td>
                            </tr>

                            <!-- Lignes LIEUX (expand/collapse) -->
                            <t t-if="isZoneExpanded(zone.id)">
                                <t t-foreach="zone.lieux" t-as="lieu" t-key="lieu.id">
                                    <tr class="rdd-lieu-row">
                                        <td style="padding-left:32px !important;">
                                            <span style="margin-left:20px;">📍 <t t-esc="lieu.name"/></span>
                                        </td>
                                        <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                            <td>
                                                <t t-set="cell" t-value="getCellLieu(zone.id, lieu.id, cat.id)"/>
                                                <t t-if="cell.count > 0">
                                                    <div class="rdd-cell-count"><t t-esc="cell.count"/></div>
                                                    <div class="rdd-cell-jours">(<t t-esc="cell.jours"/> j)</div>
                                                </t>
                                                <t t-else="">
                                                    <span class="rdd-cell-empty">·</span>
                                                </t>
                                            </td>
                                        </t>
                                        <td class="rdd-total-col">
                                            <t t-set="tl" t-value="getLieuTotal(zone.id, lieu.id)"/>
                                            <div class="rdd-cell-count"><t t-esc="tl.count"/></div>
                                            <div class="rdd-cell-jours">(<t t-esc="tl.jours"/> j)</div>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="rdd-total-row">
                            <td>Total général</td>
                            <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                <td>
                                    <t t-set="tc" t-value="getTotalCat(cat.id)"/>
                                    <div class="rdd-cell-count"><t t-esc="tc.count"/></div>
                                    <div class="rdd-cell-jours">(<t t-esc="tc.jours"/> j)</div>
                                </td>
                            </t>
                            <td class="rdd-total-col">
                                <div class="rdd-cell-count" style="color:#6a1b9a;">
                                    <t t-esc="state.grand_total.count"/>
                                </div>
                                <div class="rdd-cell-jours">(<t t-esc="state.grand_total.jours"/> j)</div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Graphiques -->
        <div class="rdd-charts-grid">
            <div class="rdd-card">
                <div class="rdd-chart-title">📍 Par zone</div>
                <div style="padding:20px;">
                    <canvas id="rdd-chart-lieux" style="width:100%; max-height:380px;"/>
                </div>
            </div>
            <div class="rdd-card">
                <div class="rdd-chart-title">🏷️ Par catégorie de client</div>
                <div style="padding:20px;">
                    <canvas id="rdd-chart-categories" style="width:100%; max-height:380px;"/>
                </div>
            </div>
        </div>
    </t>

</div>
    </t>

</templates>