<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dashboard_analytics.BalanceDashboard">
<div style="padding:16px; background:#f1f5f9;">
<style>
.o_action { overflow-y:auto !important; height:100% !important; }
.o_view_controller { overflow-y:auto !important; height:100% !important; }
.o_action_manager { overflow-y:auto !important; }

.bal-header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:12px;
    background:#fff;
    border-radius:16px;
    padding:16px 24px;
    margin-bottom:20px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
}
.bal-title {
    font-size:20px;
    font-weight:800;
    color:#1e293b;
}
.bal-select-zone,
.bal-select-year {
    border-radius:8px;
    border:1.5px solid #e2e8f0;
    font-size:13px;
    color:#1e293b;
    background:#f8fafc;
    padding:7px 12px;
}
.bal-select-zone { width:220px; }
.bal-select-year { width:120px; font-weight:700; }
.bal-table-wrapper {
    background:#fff;
    border-radius:16px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
    overflow:hidden;
}
.bal-table {
    width:100%;
    border-collapse:collapse;
}
.bal-table thead tr {
    background:linear-gradient(135deg,#1e1b4b,#6366f1);
    color:#fff;
}
.bal-table th {
    padding:14px 20px;
    font-size:13px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.6px;
    text-align:center;
}
.bal-table th:first-child { text-align:left; }
.bal-table td {
    padding:13px 20px;
    font-size:14px;
    text-align:center;
    border-bottom:1px solid #f1f5f9;
    color:#1e293b;
}
.bal-table td:first-child {
    text-align:left;
    font-weight:700;
    color:#475569;
}
.bal-table tbody tr:hover td { background:#f8fafc; }
.bal-table tfoot tr {
    background:linear-gradient(135deg,#f8fafc,#f1f5f9);
    font-weight:800;
}
.bal-table tfoot td {
    border-top:2px solid #e2e8f0;
    font-size:14px;
}
.bal-positive { color:#16a34a; font-weight:800; }
.bal-negative { color:#dc2626; font-weight:800; }
.bal-badge {
    display:inline-block;
    padding:3px 10px;
    border-radius:20px;
    font-size:12px;
    font-weight:800;
    color:#fff;
}
.bal-badge-up   { background:#16a34a; }
.bal-badge-down { background:#dc2626; }
.bal-badge-null { background:#94a3b8; }
.bal-btn-retour {
    display:flex;
    align-items:center;
    gap:6px;
    padding:8px 18px;
    border-radius:9px;
    border:1.5px solid #e2e8f0;
    background:#f8fafc;
    color:#475569;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    transition:background .2s, transform .15s;
}
.bal-btn-retour:hover {
    background:#e2e8f0;
    transform:translateY(-2px);
}
.bal-pie-grid {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-top:20px;
}
@media (max-width:900px) {
    .bal-pie-grid { grid-template-columns:1fr; }
}
.bal-pie-title {
    font-size:15px;
    font-weight:800;
    color:#1e293b;
    margin-bottom:16px;
    text-align:center;
}
</style>

<div class="bal-header">

    <div style="display:flex; align-items:center; gap:10px;">
        <button class="bal-btn-retour" t-on-click="retourDashboard">
            ← Retour
        </button>
        <div class="bal-title">
            Comparaison mensuelle de la Balance
        </div>
    </div>

    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">

        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase;">Année</span>
            <select class="bal-select-year form-select form-select-sm"
                    t-on-change="updateSelectedYear">
                <t t-foreach="state.years" t-as="year" t-key="year">
                    <option t-att-value="year"
                            t-att-selected="state.annee_n == year"
                            t-esc="year"/>
                </t>
            </select>
        </div>

        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase;">Zone</span>
            <select class="bal-select-zone form-select form-select-sm"
                    t-on-change="updateSelectedZone">
                <option value="">🌍 Toutes les zones</option>
                <t t-foreach="state.zones" t-as="zone" t-key="zone.id">
                    <option t-att-value="zone.id"
                            t-att-selected="state.selected_zone == zone.id"
                            t-esc="zone.name"/>
                </t>
            </select>
        </div>

    </div>

</div>

<t t-if="state.loading">
    <div style="text-align:center; padding:60px; font-size:16px; color:#94a3b8;">
        ⏳ Chargement…
    </div>
</t>

<t t-else="">
    <div class="bal-table-wrapper">
        <table class="bal-table">
            <thead>
                <tr>
                    <th>Mois</th>
                    <th><t t-esc="state.annee_n1"/> (DA)</th>
                    <th><t t-esc="state.annee_n"/> (DA)</th>
                    <th>Évolution</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="state.rows" t-as="row" t-key="row.mois">
                    <tr>
                        <td><t t-esc="row.label"/></td>

                        <td t-attf-class="{{ isPositive(row.bal_n1) ? 'bal-positive' : 'bal-negative' }}">
                            <t t-if="!isPositive(row.bal_n1)">- </t><t t-esc="fmtRow(row.bal_n1)"/>
                        </td>

                        <td t-attf-class="{{ isPositive(row.bal_n) ? 'bal-positive' : 'bal-negative' }}">
                            <t t-if="!isPositive(row.bal_n)">- </t><t t-esc="fmtRow(row.bal_n)"/>
                        </td>

                        <td>
                            <t t-if="row.delta !== null">
                                <span t-attf-class="bal-badge {{ row.delta >= 0 ? 'bal-badge-up' : 'bal-badge-down' }}">
                                    <t t-if="row.delta >= 0">▲ +<t t-esc="row.delta"/> %</t>
                                    <t t-else="">▼ <t t-esc="row.delta"/> %</t>
                                </span>
                            </t>
                            <t t-else="">
                                <span class="bal-badge bal-badge-null">—</span>
                            </t>
                        </td>
                    </tr>
                </t>
            </tbody>
            <tfoot>
                <tr>
                    <td>Total</td>
                    <td t-attf-class="{{ isPositive(totalN1) ? 'bal-positive' : 'bal-negative' }}">
                        <t t-esc="totalN1Fmt"/>
                    </td>
                    <td t-attf-class="{{ isPositive(totalN) ? 'bal-positive' : 'bal-negative' }}">
                        <t t-esc="totalNFmt"/>
                    </td>
                    <td>
                        <t t-if="totalDelta !== null">
                            <span t-attf-class="bal-badge {{ totalDelta >= 0 ? 'bal-badge-up' : 'bal-badge-down' }}">
                                <t t-if="totalDelta >= 0">▲ +<t t-esc="totalDelta"/> %</t>
                                <t t-else="">▼ <t t-esc="totalDelta"/> %</t>
                            </span>
                        </t>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="bal-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:16px;">
            📊 Comparaison mensuelle — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>
        <canvas id="bal-chart" style="width:100%; max-height:400px;"/>
    </div>

    <div class="bal-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:16px;">
            📈 Évolution mensuelle — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>
        <canvas id="bal-chart-line" style="width:100%; max-height:400px;"/>
    </div>

    <div class="bal-pie-grid">

        <div class="bal-table-wrapper" style="padding:24px;">
            <div class="bal-pie-title">
                Balance par zone — <t t-esc="state.annee_n1"/>
            </div>
            <canvas id="bal-chart-pie-n1" style="width:100%; max-height:500px;"/>
        </div>

        <div class="bal-table-wrapper" style="padding:24px;">
            <div class="bal-pie-title">
             Balance par zone — <t t-esc="state.annee_n"/>
            </div>
            <canvas id="bal-chart-pie" style="width:100%; max-height:500px;"/>
        </div>

    </div>

</t>

</div>
    </t>
</templates>