
<templates xml:space="preserve">
    <t t-name="dashboard_analytics.CaDashboard">
<div style="padding:16px; background:#f1f5f9;">
<style>
.o_action { overflow-y:auto !important; height:100% !important; }
.o_view_controller { overflow-y:auto !important; height:100% !important; }
.o_action_manager { overflow-y:auto !important; }

.ca-header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:12px;
    background:#fff;
    border-radius:16px;
    padding:16px 24px;
    margin-bottom:20px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
}
.ca-title {
    font-size:20px;
    font-weight:800;
    color:#1e293b;
}
.ca-select-zone,
.ca-select-year {
    border-radius:8px;
    border:1.5px solid #e2e8f0;
    font-size:13px;
    color:#1e293b;
    background:#f8fafc;
    padding:7px 12px;
}
.ca-select-zone { width:220px; }
.ca-select-year { width:120px; font-weight:700; }
.ca-table-wrapper {
    background:#fff;
    border-radius:16px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
    overflow:hidden;
}
.ca-table {
    width:100%;
    border-collapse:collapse;
}
.ca-table thead tr {
    background:linear-gradient(135deg,#1565c0,#6a1b9a);
    color:#fff;
}
.ca-table th {
    padding:14px 20px;
    font-size:13px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.6px;
    text-align:center;
}
.ca-table th:first-child { text-align:left; }
.ca-table td {
    padding:13px 20px;
    font-size:14px;
    text-align:center;
    border-bottom:1px solid #f1f5f9;
    color:#1e293b;
}
.ca-table td:first-child {
    text-align:left;
    font-weight:700;
    color:#475569;
}
.ca-table tbody tr:hover td { background:#f8fafc; }
.ca-table tfoot tr {
    background:linear-gradient(135deg,#f8fafc,#f1f5f9);
    font-weight:800;
}
.ca-table tfoot td {
    border-top:2px solid #e2e8f0;
    font-size:14px;
}
.ca-clickable {
    cursor:pointer;
    color:#1565c0;
    font-weight:700;
    text-decoration:underline dotted;
}
.ca-clickable:hover { color:#6a1b9a; }
.ca-badge {
    display:inline-block;
    padding:3px 10px;
    border-radius:20px;
    font-size:12px;
    font-weight:800;
    color:#fff;
}
.ca-badge-up   { background:#16a34a; }
.ca-badge-down { background:#dc2626; }
.ca-badge-null { background:#94a3b8; }
.ca-btn-retour {
    display:flex;
    align-items:center;
    gap:6px;
    padding:8px 18px;
    border-radius:9px;
    border:1.5px solid #e2e8f0;
    background:#f8fafc;
    color:#475569;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    transition:background .2s, transform .15s;
}
.ca-btn-retour:hover {
    background:#e2e8f0;
    transform:translateY(-2px);
}
.ca-pie-grid {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-top:20px;
}
@media (max-width:900px) {
    .ca-pie-grid { grid-template-columns:1fr; }
}
.ca-pie-title {
    font-size:15px;
    font-weight:800;
    color:#1e293b;
    margin-bottom:16px;
    text-align:center;
}
</style>

<div class="ca-header">

    <div style="display:flex; align-items:center; gap:10px;">
        <button class="ca-btn-retour" t-on-click="retourDashboard">
            ← Retour
        </button>
        <div class="ca-title">
           Comparaison mensuelle du Chiffre d'affaires
        </div>
    </div>

    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">

        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase;">Année</span>
            <select class="ca-select-year form-select form-select-sm"
                    t-on-change="updateSelectedYear">
                <t t-foreach="state.years" t-as="year" t-key="year">
                    <option t-att-value="year"
                            t-att-selected="state.annee_n == year"
                            t-esc="year"/>
                </t>
            </select>
        </div>

        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase;">Zone</span>
            <select class="ca-select-zone form-select form-select-sm"
                    t-on-change="updateSelectedZone">
                <option value="">🌍 Toutes les zones</option>
                <t t-foreach="state.zones" t-as="zone" t-key="zone.id">
                    <option t-att-value="zone.id"
                            t-att-selected="state.selected_zone == zone.id"
                            t-esc="zone.name"/>
                </t>
            </select>
        </div>

    </div>

</div>

<t t-if="state.loading">
    <div style="text-align:center; padding:60px; font-size:16px; color:#94a3b8;">
        ⏳ Chargement…
    </div>
</t>

<t t-else="">
    <div class="ca-table-wrapper">
        <table class="ca-table">
            <thead>
                <tr>
                    <th>Mois</th>
                    <th><t t-esc="state.annee_n1"/> (DA)</th>
                    <th><t t-esc="state.annee_n"/> (DA)</th>
                    <th>Évolution</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="state.rows" t-as="row" t-key="row.mois">
                    <tr>
                        <td><t t-esc="row.label"/></td>

                        <td class="ca-clickable"
    t-on-click="() => this.ouvrirMois(state.annee_n1, row.mois)">
    <t t-esc="fmtRow(row.ca_n1)"/>
</td>

                        <td class="ca-clickable"
    t-on-click="() => this.ouvrirMois(state.annee_n, row.mois)">
    <t t-esc="fmtRow(row.ca_n)"/>
</td>

                        <td>
                            <t t-if="row.delta !== null">
                                <span t-attf-class="ca-badge {{ row.delta >= 0 ? 'ca-badge-up' : 'ca-badge-down' }}">
                                    <t t-if="row.delta >= 0">▲ +<t t-esc="row.delta"/> %</t>
                                    <t t-else="">▼ <t t-esc="row.delta"/> %</t>
                                </span>
                            </t>
                            <t t-else="">
                                <span class="ca-badge ca-badge-null">—</span>
                            </t>
                        </td>
                    </tr>
                </t>
            </tbody>
            <tfoot>
                <tr>
                    <td>Total</td>
                    <td><t t-esc="totalN1Fmt"/></td>
                    <td><t t-esc="totalNFmt"/></td>
                    <td>
                        <t t-if="totalDelta !== null">
                            <span t-attf-class="ca-badge {{ totalDelta >= 0 ? 'ca-badge-up' : 'ca-badge-down' }}">
                                <t t-if="totalDelta >= 0">▲ +<t t-esc="totalDelta"/> %</t>
                                <t t-else="">▼ <t t-esc="totalDelta"/> %</t>
                            </span>
                        </t>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="ca-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:16px;">
            📊 Comparaison mensuelle — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>
        <canvas id="ca-chart" style="width:100%; max-height:400px;"/>
    </div>

    <div class="ca-table-wrapper" style="margin-top:20px; padding:24px;">
        <div style="font-size:16px; font-weight:800; color:#1e293b; margin-bottom:16px;">
            📈 Évolution mensuelle — <t t-esc="state.annee_n1"/> vs <t t-esc="state.annee_n"/>
        </div>
        <canvas id="ca-chart-line" style="width:100%; max-height:400px;"/>
    </div>


</t>

</div>
    </t>


    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- ROI DASHBOARD TEMPLATE — ajoutée ici, rien d'autre changé -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <t t-name="dashboard_analytics.RoiDashboard">
<div style="padding:16px; background:#f1f5f9;">
<style>
.roi-header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:12px;
    background:#fff;
    border-radius:16px;
    padding:16px 24px;
    margin-bottom:20px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
}
.roi-title {
    font-size:20px;
    font-weight:800;
    color:#1e293b;
}
.roi-subtitle {
    font-size:13px;
    color:#64748b;
    margin-top:3px;
}
.roi-table-wrapper {
    background:#fff;
    border-radius:16px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
    overflow:auto;
}
.roi-table {
    width:100%;
    border-collapse:collapse;
    min-width:900px;
}
/* En-tête colonne (mois départ) */
.roi-table thead tr:first-child th {
    background:linear-gradient(135deg,#0f4c81,#1565c0);
    color:#fff;
    padding:12px 8px;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.5px;
    text-align:center;
    white-space:nowrap;
}
.roi-table thead tr:first-child th:first-child {
    background:linear-gradient(135deg,#1e293b,#334155);
    text-align:left;
    padding-left:16px;
    min-width:110px;
}
/* Sous-titre colonnes */
.roi-table thead tr:last-child th {
    background:#1e40af;
    color:#bfdbfe;
    padding:6px 4px;
    font-size:10px;
    font-weight:600;
    text-align:center;
}
.roi-table thead tr:last-child th:first-child {
    background:#0f172a;
    color:#94a3b8;
    padding-left:16px;
    text-align:left;
}
/* Lignes corps */
.roi-table tbody tr:nth-child(even) td { background:#f8fafc; }
.roi-table tbody tr:hover td { background:#eff6ff !important; }
.roi-table td {
    padding:10px 8px;
    font-size:12px;
    text-align:center;
    border-bottom:1px solid #f1f5f9;
    color:#1e293b;
    white-space:nowrap;
}
/* Colonne label (mois création) */
.roi-table td:first-child {
    text-align:left;
    font-weight:700;
    color:#475569;
    padding-left:16px;
    background:#f8fafc !important;
    border-right:2px solid #e2e8f0;
    font-size:12px;
}
/* Colonne total ligne */
.roi-table td:last-child {
    font-weight:800;
    color:#1565c0;
    background:#eff6ff !important;
    border-left:2px solid #bfdbfe;
}
/* Ligne total bas */
.roi-table tfoot td {
    padding:11px 8px;
    font-size:12px;
    font-weight:800;
    text-align:center;
    background:linear-gradient(135deg,#f0f9ff,#e0f2fe) !important;
    border-top:2px solid #0ea5e9;
    color:#0c4a6e;
}
.roi-table tfoot td:first-child {
    text-align:left;
    padding-left:16px;
    color:#0f172a;
}
/* Cellule cliquable */
.roi-cell-link {
    cursor:pointer;
    color:#1565c0;
    font-weight:700;
    text-decoration:underline dotted;
    transition:color .15s;
}
.roi-cell-link:hover { color:#6a1b9a; }
/* Cellule vide */
.roi-cell-empty { color:#cbd5e1; font-size:11px; }
/* Diagonal highlight (même mois création = mois départ) */
.roi-cell-diag {
    background:#fef9c3 !important;
}
/* Intensité de couleur selon montant */
.roi-cell-low    { background:#dbeafe; }
.roi-cell-medium { background:#bfdbfe; }
.roi-cell-high   { background:#93c5fd; }
.roi-cell-top    { background:#3b82f6; color:#fff !important; }
</style>

<div class="roi-header">
    <div style="display:flex; align-items:center; gap:10px;">
        <button class="ca-btn-retour" t-on-click="retour"
                style="display:flex;align-items:center;gap:6px;padding:8px 18px;border-radius:9px;border:1.5px solid #e2e8f0;background:#f8fafc;color:#475569;font-size:13px;font-weight:600;cursor:pointer;">
            ← Retour
        </button>
        <div>
            <div class="roi-title">📐 Tableau ROI — Retour sur Investissement</div>
            <div class="roi-subtitle">
                Année <t t-esc="state.annee"/> —
                Lignes = mois de création de la réservation |
                Colonnes = mois de départ
            </div>
        </div>
    </div>
    <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:10px; padding:10px 18px; font-size:12px; color:#1e40af; font-weight:600;">
        Total annuel : <t t-esc="state.grand_total ? Math.round(state.grand_total).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ') : '0'"/> DA
    </div>
</div>

<t t-if="state.loading">
    <div style="text-align:center; padding:60px; font-size:16px; color:#94a3b8;">
        ⏳ Chargement de la matrice ROI…
    </div>
</t>

<t t-else="">
    <div class="roi-table-wrapper">
        <table class="roi-table">
            <thead>
                <tr>
                    <th>Créé \ Départ</th>
                    <t t-foreach="MOIS_LABELS" t-as="ml" t-key="ml_index">
                        <th><t t-esc="ml"/></th>
                    </t>
                    <th>Total créé</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="state.matrix" t-as="row" t-key="row_index">
                    <tr>
                        <!-- Label mois création -->
                        <td><t t-esc="MOIS_LABELS[row_index]"/></td>

                        <!-- Cellules mois départ -->
                        <t t-foreach="row" t-as="ca" t-key="ca_index">
                            <td t-att-class="'roi-cell-' + (ca >= state.grand_total * 0.05 ? 'top' : ca >= state.grand_total * 0.02 ? 'high' : ca >= state.grand_total * 0.005 ? 'medium' : ca >= 1 ? 'low' : '') + (ca_index === row_index ? ' roi-cell-diag' : '')">
                                <t t-if="ca >= 1">
                                    <span class="roi-cell-link"
                                          t-on-click="() => ouvrirDetail(row_index + 1, ca_index + 1)">
                                        <t t-esc="fmtCell(ca)"/>
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="roi-cell-empty">—</span>
                                </t>
                            </td>
                        </t>

                        <!-- Total ligne -->
                        <td><t t-esc="fmtCell(state.totaux_row[row_index])"/></td>
                    </tr>
                </t>
            </tbody>
            <tfoot>
                <tr>
                    <td>Total départ</td>
                    <t t-foreach="state.totaux_col" t-as="tc" t-key="tc_index">
                        <td><t t-esc="fmtCell(tc)"/></td>
                    </t>
                    <td><t t-esc="fmtCell(state.grand_total)"/></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Légende couleurs -->
    <div style="margin-top:12px; display:flex; gap:12px; flex-wrap:wrap; font-size:11px; color:#64748b; padding:0 4px;">
        <span style="display:flex;align-items:center;gap:4px;">
            <span style="width:14px;height:14px;border-radius:3px;background:#dbeafe;display:inline-block;border:1px solid #bfdbfe;"></span> Faible
        </span>
        <span style="display:flex;align-items:center;gap:4px;">
            <span style="width:14px;height:14px;border-radius:3px;background:#bfdbfe;display:inline-block;border:1px solid #93c5fd;"></span> Moyen
        </span>
        <span style="display:flex;align-items:center;gap:4px;">
            <span style="width:14px;height:14px;border-radius:3px;background:#93c5fd;display:inline-block;border:1px solid #60a5fa;"></span> Fort
        </span>
        <span style="display:flex;align-items:center;gap:4px;">
            <span style="width:14px;height:14px;border-radius:3px;background:#3b82f6;display:inline-block;"></span> Top
        </span>
        <span style="display:flex;align-items:center;gap:4px;">
            <span style="width:14px;height:14px;border-radius:3px;background:#fef9c3;display:inline-block;border:1px solid #fde047;"></span> Même mois
        </span>
        <span style="color:#94a3b8;">— Cliquer sur une cellule pour voir les réservations</span>
    </div>
</t>

</div>
    </t>

</templates>