<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dashboard_analytics.DashboardStatistiques">
        <div class="o_action o_dashboard p-3">

<style>
.dash-filtres {
    background:#fff;
    border-radius:16px;
    padding:16px 24px;
    margin-bottom:20px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
    display:flex;
    align-items:center;
    gap:12px;
    flex-wrap:wrap;
}
.dash-grille-1 {
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:16px;
    margin-bottom:16px;
}
.dash-grille-2 {
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:16px;
}
.dash-card {
    border-radius:18px;
    border:none;
    box-shadow:0 6px 20px rgba(0,0,0,.1);
    transition:transform .18s, box-shadow .18s;
}
.dash-card:hover {
    transform:translateY(-4px);
    box-shadow:0 10px 28px rgba(0,0,0,.2);
}
.dash-card-body-sm { padding:20px 18px; text-align:right; }
.dash-card-body-lg { padding:20px 24px; text-align:right; }
.dash-card-titre   { font-size:14px; font-weight:700; margin-bottom:10px; line-height:1.3; }
.dash-card-valeur  { font-size:22px; font-weight:900; letter-spacing:-1px; line-height:1; }
.dash-card-annee   { font-size:11px; font-weight:500; opacity:0.55; margin-top:2px; }
.dash-card-sep     { height:1px; background:rgba(0,0,0,0.12); margin:10px 0; }
.dash-card-prev    { font-size:16px; font-weight:700; opacity:0.5; line-height:1; }
.dash-card-prev-annee { font-size:11px; font-weight:500; opacity:0.4; margin-top:2px; }
.dash-filtres-dates {
    display:flex;
    align-items:center;
    gap:8px;
}
.dash-filtres-boutons {
    display:flex;
    align-items:center;
    gap:8px;
}
.dash-input-date {
    width:148px;
    border-radius:8px;
    border:1.5px solid #e2e8f0;
    font-size:13px;
    color:#1e293b;
    background:#f8fafc;
    box-shadow:inset 0 1px 3px rgba(0,0,0,.04);
}
.dash-select-zone {
    width:200px;
    border-radius:8px;
    border:1.5px solid #e2e8f0;
    font-size:13px;
    color:#1e293b;
    background:#f8fafc;
    box-shadow:inset 0 1px 3px rgba(0,0,0,.04);
}
.dash-taux-span2 { grid-column: span 1; }

@media (max-width: 768px) {
    .dash-filtres {
        flex-direction:column;
        align-items:stretch;
        padding:16px;
    }
    .dash-filtres-dates {
        flex-wrap:wrap;
        gap:8px;
    }
    .dash-filtres-boutons {
        flex-wrap:wrap;
    }
    .dash-filtres-boutons button {
        flex:1;
        justify-content:center;
    }
    .dash-input-date {
        width:100%;
        flex:1;
    }
    .dash-select-zone {
        width:100%;
        flex:1;
    }
    .dash-grille-1 {
        grid-template-columns:repeat(2,1fr);
        gap:12px;
    }
    .dash-grille-2 {
        grid-template-columns:repeat(2,1fr);
        gap:12px;
    }
    .dash-taux-span2 {
        grid-column: span 2;
    }
    .dash-card-titre { font-size:13px; }
    .dash-card-valeur { font-size:18px; }
    .dash-card-body-sm { padding:14px; }
    .dash-card-body-lg { padding:14px; }
}
</style>

<!-- Barre de filtres -->
<div class="dash-filtres">

    <div style="display:flex; align-items:center; gap:8px; margin-right:8px;">
        <div style="background:linear-gradient(135deg,#1565c0,#6a1b9a);
                    border-radius:10px; width:36px; height:36px; flex-shrink:0;
                    display:flex; align-items:center; justify-content:center;
                    font-size:18px; box-shadow:0 2px 8px rgba(21,101,192,.35);">
            📅
        </div>
        <div>
            <div style="font-weight:700; color:#1e293b; font-size:13px; line-height:1.2;">
                Période
            </div>
            <div style="font-size:11px; color:#94a3b8; line-height:1.2;">
                Filtrer les données
            </div>
        </div>
    </div>

    <div style="width:1px; height:36px; background:#e2e8f0; margin:0 4px;"/>

    <div class="dash-filtres-dates">

        <div style="display:flex; align-items:center; gap:6px;">
            <span style="font-size:10px; font-weight:600; color:#64748b;
                         text-transform:uppercase; letter-spacing:.6px; white-space:nowrap;">
                Du
            </span>
            <input type="date"
                   class="form-control form-control-sm dash-input-date"
                   t-att-value="state.date_debut"
                   t-on-change="onDateDebutChange"/>
        </div>

        <div style="color:#94a3b8; font-size:16px;">→</div>

        <div style="display:flex; align-items:center; gap:6px;">
            <span style="font-size:10px; font-weight:600; color:#64748b;
                         text-transform:uppercase; letter-spacing:.6px; white-space:nowrap;">
                Au
            </span>
            <input type="date"
                   class="form-control form-control-sm dash-input-date"
                   t-att-value="state.date_fin"
                   t-on-change="onDateFinChange"/>
        </div>

        <div style="width:1px; height:36px; background:#e2e8f0; margin:0 4px;"/>

        <div style="display:flex; align-items:center; gap:6px;">
            <span style="font-size:10px; font-weight:600; color:#64748b;
                         text-transform:uppercase; letter-spacing:.6px; white-space:nowrap;">
                Zone
            </span>
            <select class="form-select form-select-sm dash-select-zone"
                    t-on-change="updateSelectedZone">
                <option value="">🌍 Toutes les zones</option>
                <t t-foreach="state.zones" t-as="zone" t-key="zone.id">
                    <option t-att-value="zone.id"
                            t-att-selected="state.selected_zone == zone.id"
                            t-esc="zone.name"/>
                </t>
            </select>
        </div>

    </div>

    <div style="width:1px; height:36px; background:#e2e8f0; margin:0 4px;"/>

    <div class="dash-filtres-boutons">
        <button style="display:flex; align-items:center; gap:6px;
                       padding:8px 18px; border-radius:9px; border:none;
                       background:linear-gradient(135deg,#1565c0,#6a1b9a);
                       color:#fff; font-size:13px; font-weight:600;
                       box-shadow:0 3px 10px rgba(21,101,192,.4);
                       cursor:pointer; transition:opacity .2s, transform .15s;"
                t-on-click="appliquerFiltre"
                t-att-disabled="state.loading"
                onmouseenter="this.style.transform='translateY(-2px)'"
                onmouseleave="this.style.transform=''">
            <t t-if="state.loading">
                <span style="font-size:14px;">⏳</span> Chargement…
            </t>
            <t t-else="">
                <span style="font-size:14px;">🔍</span> Appliquer
            </t>
        </button>

        <button style="display:flex; align-items:center; gap:6px;
                       padding:8px 16px; border-radius:9px;
                       border:1.5px solid #e2e8f0;
                       background:#f8fafc; color:#475569;
                       font-size:13px; font-weight:600;
                       cursor:pointer; transition:background .2s, transform .15s;
                       box-shadow:0 2px 6px rgba(0,0,0,.05);"
                t-on-click="reinitialiserMois"
                t-att-disabled="state.loading"
                onmouseenter="this.style.background='#e2e8f0';this.style.transform='translateY(-2px)'"
                onmouseleave="this.style.background='#f8fafc';this.style.transform=''">
            <span style="font-size:14px;">🔄</span> Mois actuel
        </button>
    </div>

    <t t-if="labelPeriode">
        <div style="margin-left:auto; display:flex; align-items:center; gap:6px;
                    background:linear-gradient(135deg,#eff6ff,#f5f3ff);
                    border:1px solid #c7d2fe; border-radius:10px;
                    padding:6px 14px;">
            <span style="font-size:13px;">📌</span>
            <span style="font-size:12px; font-weight:600; color:#4338ca;">
                <t t-esc="labelPeriode"/>
            </span>
        </div>
    </t>

</div>

<!-- LIGNE 1 — 4 cartes -->
<div class="dash-grille-1">

    <!-- 1. Réservations confirmées -->
    <div class="dash-card" style="cursor:pointer; color:#1a3a5c;
                background:linear-gradient(135deg,#dbeafe,#bfdbfe);"
         t-on-click="ouvrirReservations">
        <div class="dash-card-body-sm">
            <div class="dash-card-titre">Réservations Confirmées</div>
            <div class="dash-card-valeur"><t t-esc="state.reservations_confirmer"/></div>
            <div class="dash-card-annee"><t t-esc="anneeActuelle"/></div>
            <t t-if="state.prev_reservations !== null">
                <div class="dash-card-sep"/>
                <div class="dash-card-prev"><t t-esc="state.prev_reservations"/></div>
                <div class="dash-card-prev-annee"><t t-esc="anneePrecedente"/></div>
            </t>
            <t t-if="deltaReservations">
                <div t-attf-style="margin-top:10px; display:inline-block; padding:3px 10px;
                                   border-radius:20px; font-size:12px; font-weight:800;
                                   background:{{ deltaReservations.positive ? '#16a34a' : '#dc2626' }}; color:#fff;">
                    <t t-if="deltaReservations.positive">▲ +<t t-esc="deltaReservations.val"/> %</t>
                    <t t-else="">▼ <t t-esc="deltaReservations.val"/> %</t>
                </div>
            </t>
        </div>
    </div>

    <!-- 2. Chiffre d'affaires -->
    <div class="dash-card" style="cursor:pointer; color:#14532d;
                background:linear-gradient(135deg,#dcfce7,#bbf7d0);"
         t-on-click="ouvrirChiffreAffaire">
        <div class="dash-card-body-sm">
            <div class="dash-card-titre">Chiffre d'affaires</div>
            <div class="dash-card-valeur"><t t-esc="caFormatted"/> DA</div>
            <div class="dash-card-annee"><t t-esc="anneeActuelle"/></div>
            <t t-if="state.prev_ca_da !== null">
                <div class="dash-card-sep"/>
                <div class="dash-card-prev"><t t-esc="fmt(state.prev_ca_da)"/> DA</div>
                <div class="dash-card-prev-annee"><t t-esc="anneePrecedente"/></div>
            </t>
            <t t-if="deltaCa">
                <div t-attf-style="margin-top:10px; display:inline-block; padding:3px 10px;
                                   border-radius:20px; font-size:12px; font-weight:800;
                                   background:{{ deltaCa.positive ? '#16a34a' : '#dc2626' }}; color:#fff;">
                    <t t-if="deltaCa.positive">▲ +<t t-esc="deltaCa.val"/> %</t>
                    <t t-else="">▼ <t t-esc="deltaCa.val"/> %</t>
                </div>
            </t>
        </div>
    </div>

    <!-- 3. Trésorerie -->
    <div class="dash-card" style="cursor:pointer; color:#6b0f3a;
                background:linear-gradient(135deg,#fce7f3,#fbcfe8);"
         t-on-click="ouvrirTresorerie">
        <div class="dash-card-body-sm">
            <div class="dash-card-titre">Trésorerie</div>
            <div class="dash-card-valeur"><t t-esc="tresorerieFormatted"/> DA</div>
            <div class="dash-card-annee"><t t-esc="anneeActuelle"/></div>
            <t t-if="state.prev_tresorerie_da !== null">
                <div class="dash-card-sep"/>
                <div class="dash-card-prev"><t t-esc="fmt(state.prev_tresorerie_da)"/> DA</div>
                <div class="dash-card-prev-annee"><t t-esc="anneePrecedente"/></div>
            </t>
            <t t-if="deltaTresorerie">
                <div t-attf-style="margin-top:10px; display:inline-block; padding:3px 10px;
                                   border-radius:20px; font-size:12px; font-weight:800;
                                   background:{{ deltaTresorerie.positive ? '#16a34a' : '#dc2626' }}; color:#fff;">
                    <t t-if="deltaTresorerie.positive">▲ +<t t-esc="deltaTresorerie.val"/> %</t>
                    <t t-else="">▼ <t t-esc="deltaTresorerie.val"/> %</t>
                </div>
            </t>
        </div>
    </div>

    <!-- 4. Panier Moyen -->
    <div class="dash-card" style="cursor:pointer; color:#7c2d00;
            background:linear-gradient(135deg,#ffedd5,#fed7aa);"
         t-on-click="ouvrirPanierMoyen">
        <div class="dash-card-body-sm">
            <div class="dash-card-titre">Panier Moyen</div>
            <div class="dash-card-valeur"><t t-esc="panierFormatted"/> DA</div>
            <div class="dash-card-annee"><t t-esc="anneeActuelle"/></div>
            <t t-if="state.prev_panier_moyen_da !== null">
                <div class="dash-card-sep"/>
                <div class="dash-card-prev"><t t-esc="fmt(state.prev_panier_moyen_da)"/> DA</div>
                <div class="dash-card-prev-annee"><t t-esc="anneePrecedente"/></div>
            </t>
            <t t-if="deltaPanier">
                <div t-attf-style="margin-top:10px; display:inline-block; padding:3px 10px;
                                   border-radius:20px; font-size:12px; font-weight:800;
                                   background:{{ deltaPanier.positive ? '#16a34a' : '#dc2626' }}; color:#fff;">
                    <t t-if="deltaPanier.positive">▲ +<t t-esc="deltaPanier.val"/> %</t>
                    <t t-else="">▼ <t t-esc="deltaPanier.val"/> %</t>
                </div>
            </t>
        </div>
    </div>

</div><!-- fin ligne 1 -->

<!-- LIGNE 2 — 3 cartes -->
<div class="dash-grille-2">

    <!-- 5. Dépenses -->
    <div class="dash-card" style="cursor:pointer; color:#7f1d1d;
                background:linear-gradient(135deg,#fee2e2,#fecaca);"
         t-on-click="ouvrirDepenses">
        <div class="dash-card-body-lg">
            <div class="dash-card-titre">Dépenses</div>
            <div class="dash-card-valeur"><t t-esc="depenseFormatted"/> DA</div>
            <div class="dash-card-annee"><t t-esc="anneeActuelle"/></div>
            <t t-if="state.prev_depense_da !== null">
                <div class="dash-card-sep"/>
                <div class="dash-card-prev"><t t-esc="fmt(state.prev_depense_da)"/> DA</div>
                <div class="dash-card-prev-annee"><t t-esc="anneePrecedente"/></div>
            </t>
            <t t-if="deltaDepense">
                <div t-attf-style="margin-top:10px; display:inline-block; padding:3px 12px;
                                   border-radius:20px; font-size:13px; font-weight:800;
                                   background:{{ deltaDepense.positive ? '#dc2626' : '#16a34a' }}; color:#fff;">
                    <t t-if="deltaDepense.positive">▲ +<t t-esc="deltaDepense.val"/> %</t>
                    <t t-else="">▼ <t t-esc="deltaDepense.val"/> %</t>
                </div>
            </t>
        </div>
    </div>

    <!-- 6. Balance -->
    <div class="dash-card" style="cursor:pointer; color:#1e1b4b;
                background:linear-gradient(135deg,#e0e7ff,#c7d2fe);"
         t-on-click="ouvrirBalance">
        <div class="dash-card-body-lg">
            <div class="dash-card-titre">Balance</div>
            <div class="dash-card-valeur"><t t-esc="balanceFormatted"/> DA</div>
            <div class="dash-card-annee"><t t-esc="anneeActuelle"/></div>
            <t t-if="prevBalance !== null">
                <div class="dash-card-sep"/>
                <div class="dash-card-prev"><t t-esc="fmt(prevBalance)"/> DA</div>
                <div class="dash-card-prev-annee"><t t-esc="anneePrecedente"/></div>
            </t>
            <t t-if="deltaBalance">
                <div t-attf-style="margin-top:10px; display:inline-block; padding:3px 12px;
                                   border-radius:20px; font-size:13px; font-weight:800;
                                   background:{{ deltaBalance.positive ? '#16a34a' : '#dc2626' }}; color:#fff;">
                    <t t-if="deltaBalance.positive">▲ +<t t-esc="deltaBalance.val"/> %</t>
                    <t t-else="">▼ <t t-esc="deltaBalance.val"/> %</t>
                </div>
            </t>
        </div>
    </div>

    <!-- 7. Taux de remplissage — pas de delta, pas de N-1 -->
    <div class="dash-card dash-taux-span2" style="cursor:pointer; color:#164e4e;
                background:linear-gradient(135deg,#cffafe,#a5f3fc);"
         t-on-click="ouvrirTauxRemplissage">
        <div class="dash-card-body-lg">
            <div class="dash-card-titre">Taux de remplissage</div>
            <div class="dash-card-valeur">
                <t t-esc="state.taux_remplissage"/> %
            </div>
            <div style="background:rgba(0,0,0,.1); border-radius:10px;
                        height:6px; margin:8px 0; overflow:hidden;">
                <div t-attf-style="width:{{state.taux_remplissage}}%; height:100%;
                                   background:#0e7490; border-radius:10px; transition:width .6s;"/>
            </div>
        </div>
    </div>

</div><!-- fin ligne 2 -->

        </div>
    </t>
</templates>